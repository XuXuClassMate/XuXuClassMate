---
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCopy } from "../lib/i18n";

const copy = getCopy("en");
const page = copy.notFound;
---

<BaseLayout locale="en" page="home" noindex={true}>
  <main id="main-content" class="error-wrapper">
    <div class="error-content">
      <div class="error-icon" aria-hidden="true">
        <Icon name="ghost" />
      </div>
      <h1 class="error-code">404</h1>
      <h2 class="error-title">{page.title}</h2>
      <p class="error-message">{page.message}</p>
      <a href="/" class="btn-home">
        <Icon name="arrow-left" />
        {page.homeLabel}
      </a>
    </div>
  </main>

  <Contact
    label={copy.contactLabel}
    hint={copy.contactHint}
    offers={copy.contactOffers}
    copyLabel={copy.copyEmail}
    copiedLabel={copy.copiedEmail}
  />
  <Footer
    brand={copy.brand}
    description={page.footerDesc}
    copyright={copy.copyright}
    social={page.social}
  />
</BaseLayout>
