---
import Icon from "../components/Icon.astro";
import {
  absoluteUrl,
  canonicalPath,
  caseHref,
  getCopy,
  hreflangLinks,
  jsonLdGraph,
  languageHref,
  noteHref,
  pageHref,
  type CaseSlug,
  type Locale,
  type NoteSlug,
  type PageId,
} from "../lib/i18n";
import "../styles/fonts.css";
import "../styles/global.css";

type Props = {
  locale: Locale;
  page: PageId;
  /** Root `/` English home (legacy URL). */
  rootHome?: boolean;
  noindex?: boolean;
  caseSlug?: CaseSlug;
  noteSlug?: NoteSlug;
  /** Absolute or site-relative Open Graph image path. */
  ogImagePath?: string;
  metaOverride?: {
    title: string;
    description: string;
    keywords: string;
    ogTitle?: string;
  };
};

const {
  locale,
  page,
  rootHome = false,
  noindex = false,
  caseSlug,
  noteSlug,
  ogImagePath,
  metaOverride,
} = Astro.props;
const copy = getCopy(locale);
const meta =
  metaOverride ??
  copy.meta[page === "home" ? "home" : page];
const canonical = absoluteUrl(
  caseSlug
    ? `/${locale}/work/${caseSlug}`
    : noteSlug
      ? `/${locale}/blog/${noteSlug}`
      : canonicalPath(locale, page, rootHome),
);
const alternates = caseSlug
  ? [
      { hreflang: "en", href: absoluteUrl(`/en/work/${caseSlug}`) },
      { hreflang: "zh", href: absoluteUrl(`/zh/work/${caseSlug}`) },
      { hreflang: "x-default", href: absoluteUrl(`/en/work/${caseSlug}`) },
    ]
  : noteSlug
    ? [
        { hreflang: "en", href: absoluteUrl(`/en/blog/${noteSlug}`) },
        { hreflang: "zh", href: absoluteUrl(`/zh/blog/${noteSlug}`) },
        { hreflang: "x-default", href: absoluteUrl(`/en/blog/${noteSlug}`) },
      ]
    : hreflangLinks(locale, page, rootHome);
const homeHref = locale === "zh" ? pageHref("zh", "home") : "/";
const active = page === "home" ? undefined : page;
const ogTitle = meta.ogTitle ?? meta.title;
const ogImage = absoluteUrl(ogImagePath ?? "/images/og-default.jpg");
const structuredData = noindex
  ? null
  : jsonLdGraph(locale, page, rootHome, caseSlug, noteSlug);
const langSwitchHref = caseSlug
  ? caseHref(locale === "en" ? "zh" : "en", caseSlug)
  : noteSlug
    ? noteHref(locale === "en" ? "zh" : "en", noteSlug)
    : languageHref(locale, page);
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{meta.title}</title>
    <script is:inline>
      (function () {
        try {
          let theme = localStorage.getItem("xuxu-theme");
          if (theme !== "light" && theme !== "dark") theme = "dark";
          document.documentElement.setAttribute("data-theme", theme);
        } catch {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }
    {!noindex ? <link rel="canonical" href={canonical} /> : null}
    {
      alternates.map((link) => (
        <link rel="alternate" hreflang={link.hreflang} href={link.href} />
      ))
    }
    <meta name="description" content={meta.description} />
    <meta name="keywords" content={meta.keywords} />
    <meta name="author" content={copy.author} />
    <meta name="theme-color" content="#070b14" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={copy.brand} />
    <meta property="og:locale" content={locale === "zh" ? "zh_CN" : "en_US"} />
    <meta
      property="og:locale:alternate"
      content={locale === "zh" ? "en_US" : "zh_CN"}
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.brand} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="shortcut icon" href="/images/logo.svg" />
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <link rel="apple-touch-icon" href="/images/logo.svg" />
    <link
      rel="preload"
      href="/fonts/outfit-latin-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/outfit-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      structuredData ? (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      ) : null
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skipToContent}</a>
    <header class="header" id="siteHeader">
      <div class="container">
        <nav class="nav" aria-label="Primary">
          <a href={homeHref} class="logo">
            <img
              src="/images/logo.svg"
              alt={`${copy.brand} logo`}
              width="36"
              height="36"
            />
            <span class="logo-text">{copy.brand}</span>
          </a>
          <div class="nav-end">
            <button
              type="button"
              class="theme-toggle"
              id="themeToggle"
              aria-label={copy.themeToggle}
              data-label-light={copy.themeToLight}
              data-label-dark={copy.themeToDark}
            >
              <span class="theme-toggle-icon" data-theme-icon="moon">
                <Icon name="moon" />
              </span>
              <span class="theme-toggle-icon is-hidden" data-theme-icon="sun">
                <Icon name="sun" />
              </span>
              <span class="theme-toggle-label">{copy.themeToLight}</span>
            </button>
            <button
              id="mobileNavToggle"
              class="mobile-nav-toggle"
              type="button"
              aria-label={copy.menuLabel}
              aria-expanded="false"
              aria-controls="navLinks"
            >
              <span></span>
              <span></span>
              <span></span>
            </button>
            <div class="nav-links" id="navLinks">
              <a
                href={pageHref(locale, "about")}
                class:list={["nav-item", { active: active === "about" }]}
              >
                {copy.nav.about}
              </a>
              <a
                href={pageHref(locale, "now")}
                class:list={["nav-item", { active: active === "now" }]}
              >
                {copy.nav.now ?? "Now"}
              </a>
              <a
                href={pageHref(locale, "learn")}
                class:list={["nav-item", { active: active === "learn" }]}
              >
                {copy.nav.experience}
              </a>
              <a
                href={pageHref(locale, "work")}
                class:list={["nav-item", { active: active === "work" }]}
              >
                {copy.nav.projects}
              </a>
              <a
                href={pageHref(locale, "open-source")}
                class:list={[
                  "nav-item",
                  {
                    active:
                      active === "open-source" || active === "innonestx",
                  },
                ]}
              >
                {copy.nav.openSource ?? copy.nav.innonestx}
              </a>
              <a
                href={pageHref(locale, "blog")}
                class:list={[
                  "nav-item",
                  { active: active === "blog" || active === "notes" },
                ]}
              >
                {copy.nav.blog}
              </a>
              <a
                href={pageHref(locale, "ai-testing")}
                class:list={["nav-item", { active: active === "ai-testing" }]}
              >
                {copy.nav.aiTesting}
              </a>
              <a
                href={pageHref(locale, "life")}
                class:list={["nav-item", { active: active === "life" }]}
              >
                {copy.nav.life}
              </a>
              <a href="#contact" class="nav-item">
                {copy.nav.contact}
              </a>
              <a href={langSwitchHref} class="language-switch">
                {copy.languageSwitch}
              </a>
            </div>
          </div>
        </nav>
      </div>
    </header>

    <slot />

    <button
      type="button"
      class="back-to-top"
      id="backToTop"
      aria-label={copy.backToTop}
      title={copy.backToTop}
    >
      ↑
    </button>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
