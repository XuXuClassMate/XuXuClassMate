---
import Icon from "../components/Icon.astro";
import {
  absoluteUrl,
  alternateLocalePath,
  canonicalPath,
  getCopy,
  hreflangLinks,
  jsonLdGraph,
  pageHref,
  type CaseSlug,
  type Locale,
  type NoteSlug,
  type PageId,
} from "../lib/i18n";
import "../styles/global.css";

type Props = {
  locale: Locale;
  page: PageId;
  noindex?: boolean;
  caseSlug?: CaseSlug;
  noteSlug?: NoteSlug;
  /** Absolute or site-relative Open Graph image path. */
  ogImagePath?: string;
  metaOverride?: {
    title: string;
    description: string;
    keywords: string;
    ogTitle?: string;
  };
};

const {
  locale,
  page,
  noindex = false,
  caseSlug,
  noteSlug,
  ogImagePath,
  metaOverride,
} = Astro.props;
const copy = getCopy(locale);
const meta =
  metaOverride ??
  copy.meta[page === "home" ? "home" : page];
const canonical = absoluteUrl(
  caseSlug
    ? `/${locale}/work/${caseSlug}`
    : noteSlug
      ? `/${locale}/blog/${noteSlug}`
      : canonicalPath(locale, page),
);
const alternates = caseSlug
  ? [
      { hreflang: "en", href: absoluteUrl(`/en/work/${caseSlug}`) },
      { hreflang: "zh", href: absoluteUrl(`/zh/work/${caseSlug}`) },
      { hreflang: "x-default", href: absoluteUrl(`/en/work/${caseSlug}`) },
    ]
  : noteSlug
    ? [
        { hreflang: "en", href: absoluteUrl(`/en/blog/${noteSlug}`) },
        { hreflang: "zh", href: absoluteUrl(`/zh/blog/${noteSlug}`) },
        { hreflang: "x-default", href: absoluteUrl(`/en/blog/${noteSlug}`) },
      ]
    : hreflangLinks(page);
const homeHref = locale === "zh" ? pageHref("zh", "home") : "/";
const active = page === "home" ? undefined : page;
const ogTitle = meta.ogTitle ?? meta.title;
const ogImage = absoluteUrl(ogImagePath ?? "/images/og-default.jpg");
const structuredData = noindex
  ? null
  : jsonLdGraph(locale, page, caseSlug, noteSlug);
const langSwitchHref = alternateLocalePath(Astro.url.pathname);
---

<!doctype html>
<html lang={locale} style="--liquid-tint: 0.45">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        let theme = "light";
        try {
          const stored = localStorage.getItem("xuxu-theme-choice");
          if (stored === "light" || stored === "dark") theme = stored;
          else if (window.matchMedia("(prefers-color-scheme: dark)").matches) theme = "dark";
        } catch {
          theme = "light";
        }
        const root = document.documentElement;
        root.setAttribute("data-theme", theme);
        root.style.colorScheme = theme;
        root.style.backgroundColor = theme === "dark" ? "#121212" : "#f5f5f7";
        try {
          const tint = localStorage.getItem("xuxu-liquid-tint");
          let n = tint == null ? 0.45 : Number(tint);
          if (!Number.isFinite(n)) n = 0.45;
          n = Math.min(1, Math.max(0, n));
          root.style.setProperty("--liquid-tint", String(n));
        } catch {
          root.style.setProperty("--liquid-tint", "0.45");
        }
      })();
    </script>
    <style is:inline>
      html { background-color: #f5f5f7; color-scheme: light; }
      html[data-theme="dark"] { background-color: #121212; color-scheme: dark; }
    </style>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title>{meta.title}</title>
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }
    {!noindex ? <link rel="canonical" href={canonical} /> : null}
    {
      alternates.map((link) => (
        <link rel="alternate" hreflang={link.hreflang} href={link.href} />
      ))
    }
    <meta name="description" content={meta.description} />
    <meta name="keywords" content={meta.keywords} />
    <meta name="author" content={copy.author} />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1c1e" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={copy.brand} />
    <meta property="og:locale" content={locale === "zh" ? "zh_CN" : "en_US"} />
    <meta
      property="og:locale:alternate"
      content={locale === "zh" ? "en_US" : "zh_CN"}
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.brand} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="shortcut icon" href="/images/logo.svg" />
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <link rel="apple-touch-icon" href="/images/logo.svg" />
    {
      structuredData ? (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      ) : null
    }
  </head>
  <body class:list={{ "page-home": page === "home" }}>
    <svg class="lg-filters" width="0" height="0" aria-hidden="true" focusable="false">
      <filter id="lg-refract" x="-12%" y="-12%" width="124%" height="124%" color-interpolation-filters="sRGB">
        <feImage id="lg-lens-map" result="map" preserveAspectRatio="none" href=""></feImage>
        <feDisplacementMap in="SourceGraphic" in2="map" scale="14" xChannelSelector="R" yChannelSelector="G" result="bent"></feDisplacementMap>
        <feGaussianBlur in="bent" stdDeviation="0.3"></feGaussianBlur>
      </filter>
    </svg>
    <a class="skip-link" href="#main-content">{copy.skipToContent}</a>
    <header class="header" id="siteHeader">
      <div class="header-glass" aria-hidden="true"></div>
      <div class="container">
        <nav class="nav" aria-label="Primary">
          <a href={homeHref} class="logo">
            <img
              src="/images/logo.svg"
              alt={`${copy.brand} logo`}
              width="36"
              height="36"
            />
            <span class="logo-text">{copy.brand}</span>
          </a>
          <div class="nav-end">
            <div class="nav-links" id="navLinks">
              <div class="nav-links-glass" aria-hidden="true"></div>
              <div class="nav-links-scroll">
              <a
                href={pageHref(locale, "work")}
                class:list={[
                  "nav-item",
                  "nav-item--products",
                  { active: active === "work" },
                ]}
              >
                {copy.nav.products ?? "Products"}
              </a>
              <a
                href={pageHref(locale, "learn")}
                class:list={[
                  "nav-item",
                  "nav-item--engineering",
                  { active: active === "learn" },
                ]}
              >
                {copy.nav.engineering ?? "Engineering"}
              </a>
              <a
                href={pageHref(locale, "about")}
                class:list={[
                  "nav-item",
                  "nav-item--about",
                  { active: active === "about" },
                ]}
              >
                {copy.nav.about}
              </a>
              <div class="nav-utils">
                <a
                  href={langSwitchHref}
                  class="language-switch"
                  aria-label={copy.languageSwitchHint}
                  title={copy.languageSwitchHint}
                >
                  {copy.languageSwitch}
                </a>
                <button
                  type="button"
                  class="theme-toggle"
                  id="themeToggle"
                  aria-label={copy.themeToLight}
                  title={copy.themeToLight}
                  data-label-light={copy.themeToLight}
                  data-label-dark={copy.themeToDark}
                >
                  <span
                    class="theme-toggle-icon"
                    data-theme-icon="moon"
                    aria-hidden="true"
                  >
                    <Icon name="moon" />
                  </span>
                  <span
                    class="theme-toggle-icon is-hidden"
                    data-theme-icon="sun"
                    aria-hidden="true"
                  >
                    <Icon name="sun" />
                  </span>
                  <span class="theme-toggle-label">{copy.themeToggle}</span>
                </button>
              </div>
              </div>
            </div>
            <button
              id="mobileNavToggle"
              class="mobile-nav-toggle"
              type="button"
              aria-label={copy.menuLabel}
              aria-expanded="false"
              aria-controls="navLinks"
            >
              <span></span>
              <span></span>
              <span></span>
            </button>
          </div>
        </nav>
      </div>
    </header>

    <slot />

    <button class="nav-scrim" id="navScrim" type="button" tabindex="-1" aria-hidden="true"></button>
    <nav class="tabbar lg-regular" aria-label={locale === "zh" ? "主要页面" : "Primary"}>
      <a class:list={["tabbar-item", { "is-active": page === "home" }]} href={homeHref}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1v-9.5Z"></path></svg>
        <span>{locale === "zh" ? "首页" : "Home"}</span>
      </a>
      <a class:list={["tabbar-item", { "is-active": page === "work" }]} href={pageHref(locale, "work")}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="1.5"></rect><rect x="13" y="4" width="7" height="7" rx="1.5"></rect><rect x="4" y="13" width="7" height="7" rx="1.5"></rect><rect x="13" y="13" width="7" height="7" rx="1.5"></rect></svg>
        <span>{copy.nav.products ?? copy.nav.projects}</span>
      </a>
      <a class:list={["tabbar-item", { "is-active": page === "learn" }]} href={pageHref(locale, "learn")}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M7 3.5h8.5L19 7v13.5a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1v-16a1 1 0 0 1 1-1Z"></path><path d="M15 3.5V7h4M8.5 12h7M8.5 16h5"></path></svg>
        <span>{copy.nav.engineering ?? "Engineering"}</span>
      </a>
      <a class:list={["tabbar-item", { "is-active": page === "about" }]} href={pageHref(locale, "about")}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="8" r="3.2"></circle><path d="M5.5 19.5c1.2-2.8 3.4-4 6.5-4s5.3 1.2 6.5 4"></path></svg>
        <span>{copy.nav.about}</span>
      </a>
      <button class="tabbar-item" id="tabMore" type="button" aria-controls="navLinks" aria-expanded="false" aria-label={copy.menuLabel}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="6" cy="12" r="1.2" fill="currentColor"></circle><circle cx="12" cy="12" r="1.2" fill="currentColor"></circle><circle cx="18" cy="12" r="1.2" fill="currentColor"></circle></svg>
        <span>{copy.menuLabel}</span>
      </button>
    </nav>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
