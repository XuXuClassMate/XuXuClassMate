---
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import PageHero from "./PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { NOTE_CATEGORIES } from "../content/notes";
import { getCopy, noteHref, type Locale } from "../lib/i18n";

type Props = { locale: Locale };

const { locale } = Astro.props;
const copy = getCopy(locale);
const page = copy.notes;
const categories = NOTE_CATEGORIES.filter((category) =>
  page.items.some((item) => item.category === category),
);
---

<BaseLayout locale={locale} page="blog">
  <main id="main-content">
    <PageHero
      subtitle={page.subtitle}
      title={page.title}
      description={page.description}
    />

    <section class="notes-index">
      <div class="container">
        <div class="section-head reveal-on-scroll">
          <h2 class="section-title" id="notes-heading">{page.categoriesLabel}</h2>
          <div
            class="note-filters project-filters"
            role="group"
            aria-labelledby="notes-heading"
          >
            <button
              type="button"
              class="filter-btn is-active"
              data-filter="all"
              aria-pressed="true"
            >
              {page.filterAll}
            </button>
            {
              categories.map((category) => (
                <button
                  type="button"
                  class="filter-btn"
                  data-filter={category}
                  aria-pressed="false"
                >
                  {category}
                </button>
              ))
            }
          </div>
        </div>

        <div class="notes-grid notes-grid--index" id="notes-grid">
          {
            page.items.map((item, index) => (
              <article
                class={`note-card note-card--rich reveal-on-scroll reveal-delay-${(index % 3) + 1}`}
                data-category={item.category}
              >
                <p class="note-category">{item.category}</p>
                <ul class="note-tags">
                  {item.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
                <h2>
                  <a href={noteHref(locale, item.slug)}>{item.title}</a>
                </h2>
                <p>{item.description}</p>
                {item.proof ? <p class="note-card-proof">{item.proof}</p> : null}
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Contact
    label={copy.contactLabel}
    hint={copy.contactHint}
    offers={copy.contactOffers}
    copyLabel={copy.copyEmail}
    copiedLabel={copy.copiedEmail}
  />
  <Footer
    brand={copy.brand}
    description={page.footerDesc}
    copyright={copy.copyright}
    social={page.social}
  />
</BaseLayout>
