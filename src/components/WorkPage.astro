---
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import PageHero from "./PageHero.astro";
import ProjectCard from "./ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCopy, type Locale } from "../lib/i18n";

type Props = { locale: Locale };

const { locale } = Astro.props;
const copy = getCopy(locale);
const page = copy.work;
const categories = [
  ...new Set(
    page.projects
      .map((project) => project.category)
      .filter((category): category is string => Boolean(category)),
  ),
];
---

<BaseLayout locale={locale} page="work">
  <main id="main-content">
    <PageHero
      subtitle={page.subtitle}
      title={page.title}
      description={page.description}
    />

    <section class="featured-projects">
      <div class="container">
        <div class="section-head reveal-on-scroll">
          <h2 class="section-title" id="projects-heading">
            {page.projectsTitle}
          </h2>
          <div
            class="project-filters"
            role="group"
            aria-labelledby="projects-heading"
          >
            <button
              type="button"
              class="filter-btn is-active"
              data-filter="all"
              aria-pressed="true"
            >
              {page.filterAll}
            </button>
            {
              categories.map((category) => (
                <button
                  type="button"
                  class="filter-btn"
                  data-filter={category}
                  aria-pressed="false"
                >
                  {category}
                </button>
              ))
            }
          </div>
        </div>
        <div class="project-grid" id="project-grid">
          {
            page.projects.map((item, index) => (
              <ProjectCard item={item} index={index} filterable />
            ))
          }
        </div>
      </div>
    </section>

    <section class="approach">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{page.approachTitle}</h2>
        <div class="approach-grid">
          {
            page.approach.map((item, index) => (
              <div
                class={`approach-card reveal-on-scroll reveal-delay-${index + 1}`}
              >
                <span class="approach-index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="technical-skills">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{page.skillsTitle}</h2>
        <div class="skills-grid skills-grid--evidence">
          {
            page.skills.map((skill, index) => (
              <div
                class={`skill-item skill-item--evidence reveal-on-scroll reveal-delay-${(index % 3) + 1}`}
              >
                <h3>{skill.title}</h3>
                <ul class="skill-list">
                  {skill.items.map((entry) => (
                    <li>{entry}</li>
                  ))}
                </ul>
                {skill.evidence?.length ? (
                  <div class="skill-evidence">
                    {skill.evidence.map((link) => (
                      <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {link.label}
                      </a>
                    ))}
                  </div>
                ) : null}
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Contact
    label={copy.contactLabel}
    hint={copy.contactHint}
    offers={copy.contactOffers}
    copyLabel={copy.copyEmail}
    copiedLabel={copy.copiedEmail}
  />
  <Footer
    brand={copy.brand}
    description={page.footerDesc}
    copyright={copy.copyright}
    social={page.social}
  />
</BaseLayout>
