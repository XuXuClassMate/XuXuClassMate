---
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import PageHero from "./PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAbout } from "../content/about";
import { getPortfolioHome } from "../content/portfolio-home";
import { getCopy, type Locale } from "../lib/i18n";

type Props = { locale: Locale };

const { locale } = Astro.props;
const copy = getCopy(locale);
const about = getAbout(locale);
const home = getPortfolioHome(locale);
const isZh = locale === "zh";
---

<BaseLayout locale={locale} page="about" metaOverride={about.meta}>
  <main id="main-content" class="lab-page about-page">
    <PageHero
      subtitle="QA Engineer · SDET · AI Testing"
      title={about.title}
      description=""
      actions={[
        { href: about.ctaWorkHref, label: about.ctaWork, primary: true },
      ]}
    />

    <section class="home-section">
      <div class="container">
        <h2 class="section-title">{isZh ? "我是谁" : "Who I Am"}</h2>
        <p class="section-lead">{about.intro}</p>
      </div>
    </section>

    <section class="home-section">
      <div class="container">
        <h2 class="section-title">{isZh ? "工程经历" : "Engineering Journey"}</h2>
        <p class="section-lead">
          {
            isZh
              ? "从测试自动化、接口和性能，做到可安装的 AI 测试工具。重点一直是让质量工作能在真实环境里跑起来。"
              : "From test automation, APIs, and performance into installable AI testing tools. The through-line is quality work that runs in a real environment."
          }
        </p>
      </div>
    </section>

    <section class="home-section">
      <div class="container">
        <h2 class="section-title">{isZh ? "部分结果" : "Selected Results"}</h2>
        <div class="story-metrics">
          {
            home.achievements.slice(0, 2).map((item) => (
              <article>
                <span>{item.value}</span>
                <p>{item.label}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-section">
      <div class="container">
        <h2 class="section-title">{isZh ? "工程原则" : "Engineering Philosophy"}</h2>
        <div class="principle-list">
          {
            copy.home.principles.map((item) => (
              <article>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-section">
      <div class="container">
        <h2 class="section-title">{isZh ? "当前重点" : "Current Focus"}</h2>
        <p class="section-lead">
          {
            isZh
              ? "把 AI 测试用例生成器做成可安装的产品，并继续维护可直接拉取的测试数据库镜像。"
              : "Shipping the AI Test Case Generator as an installable product, and keeping the test-database images pullable."
          }
        </p>
      </div>
    </section>
  </main>

  <Contact
    label={copy.contactLabel}
    hint={copy.contactHint}
    offers={copy.contactOffers}
    copyLabel={copy.copyEmail}
    copiedLabel={copy.copiedEmail}
  />
  <Footer
    brand={copy.brand}
    description={copy.home.footerDesc}
    copyright={copy.copyright}
    social={copy.home.social}
  />
</BaseLayout>
