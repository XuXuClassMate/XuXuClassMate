---
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import PageHero from "./PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAbout } from "../content/about";
import { getPortfolioHome } from "../content/portfolio-home";
import { getCopy, type Locale } from "../lib/i18n";

type Props = { locale: Locale };

const { locale } = Astro.props;
const copy = getCopy(locale);
const about = getAbout(locale);
const home = getPortfolioHome(locale);
---

<BaseLayout locale={locale} page="about" metaOverride={about.meta}>
  <main id="main-content" class="lab-page about-page apple-page">
    <PageHero
      subtitle="QA Engineer · SDET · AI Testing"
      title={about.title}
      description=""
      actions={[
        { href: about.ctaWorkHref, label: about.ctaWork, primary: true },
      ]}
    />

    <section class="home-section">
      <div class="container">
        <h2 class="section-title">Introduction</h2>
        <p class="section-lead">{about.intro}</p>
      </div>
    </section>

    <section class="home-section">
      <div class="container">
        <h2 class="section-title">Engineering Journey</h2>
        <p class="section-lead">
          From test automation, APIs, and performance into installable AI testing tools. The through-line is quality work that runs in a real environment.
        </p>
      </div>
    </section>

    <section class="home-section">
      <div class="container">
        <h2 class="section-title">Selected Results</h2>
        <div class="story-metrics">
          {
            home.achievements.slice(0, 2).map((item) => (
              <article>
                <span>{item.value}</span>
                <p>{item.label}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-section">
      <div class="container">
        <h2 class="section-title">Engineering Philosophy</h2>
        <div class="principle-list">
          {
            copy.home.principles.map((item) => (
              <article>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-section">
      <div class="container">
        <h2 class="section-title">Current Focus</h2>
        <p class="section-lead">
          AI Testing, Agentic QA, and automation infrastructure: shipping the test-case generator as an installable product, and keeping the test-database images pullable.
        </p>
      </div>
    </section>

    <section class="home-section" id="services">
      <div class="container">
        <h2 class="section-title">{home.servicesTitle}</h2>
        <p class="section-lead">{home.servicesLead}</p>
        <ul class="service-directory">
          {
            home.services.map((item) => (
              <li>
                <a href={item.href} target="_blank" rel="noopener noreferrer">
                  <span class="service-directory-name">{item.title}</span>
                  <span class="service-directory-detail">{item.detail}</span>
                  <span class="service-directory-host">
                    {item.host}
                    <span aria-hidden="true">›</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <Contact
    label={copy.contactLabel}
    hint={copy.contactHint}
    offers={copy.contactOffers}
    copyLabel={copy.copyEmail}
    copiedLabel={copy.copiedEmail}
  />
  <Footer
    locale={locale}
    brand={copy.brand}
    description={copy.home.footerDesc}
    copyright={copy.copyright}
    social={copy.home.social}
  />
</BaseLayout>
