---
import type { Card } from "../content/types";

type Props = {
  item: Card;
  index?: number;
  filterable?: boolean;
};

const { item, index = 0, filterable = false } = Astro.props;
const delay = (index % 3) + 1;
const valueLine = (item.description.split(/\s*[—–]\s*|——/)[0] ?? item.description)
  .split("。")[0]
  .trim();
const imageDark = item.imageDark ?? item.image?.replace(/\.jpg$/i, "-dark.jpg");
---

<article
  class={`project-card featured reveal-on-scroll reveal-delay-${delay}`}
  data-category={filterable ? (item.category ?? "all") : undefined}
>
  {
    item.image ? (
      <a
        class="project-cover"
        href={item.caseHref ?? item.href}
        target={item.caseHref ? undefined : "_blank"}
        rel={item.caseHref ? undefined : "noopener noreferrer"}
      >
        <img
          class="theme-cover theme-cover--light"
          src={item.image}
          alt={item.imageAlt ?? item.title}
          width="960"
          height="540"
          loading="lazy"
          decoding="async"
        />
        {imageDark ? (
          <img
            class="theme-cover theme-cover--dark"
            src={imageDark}
            alt=""
            width="960"
            height="540"
            loading="lazy"
            decoding="async"
            aria-hidden="true"
            onerror="this.remove()"
          />
        ) : null}
      </a>
    ) : null
  }
  <div class="project-content">
    {item.status ? <span class="project-category">{item.status}</span> : null}
    <h3>{item.title}</h3>
    <p>{valueLine}</p>
    <div class="project-links">
      {
        item.demoHref && item.demoLabel ? (
          <a href={item.demoHref} class="project-link">
            {item.demoLabel}
          </a>
        ) : null
      }
      {
        item.caseHref && item.caseLabel ? (
          <a href={item.caseHref} class="project-link">
            {item.caseLabel}
          </a>
        ) : null
      }
      {
        item.href && item.linkLabel && item.href !== "#" ? (
          <a
            href={item.href}
            class={`project-link${item.caseHref ? " project-link--secondary" : ""}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            {item.linkLabel}
          </a>
        ) : null
      }
      {
        item.ctaHref && item.ctaLabel ? (
          <a
            href={item.ctaHref}
            class="project-link project-link--secondary"
            target="_blank"
            rel="noopener noreferrer"
          >
            {item.ctaLabel}
          </a>
        ) : null
      }
    </div>
  </div>
</article>
