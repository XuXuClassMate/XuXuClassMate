---
import Icon from "./Icon.astro";
import type { SocialLink } from "../content/types";

type Props = {
  brand: string;
  description: string;
  copyright: string;
  social: SocialLink[];
  builtWith?: string;
  lastUpdatedLabel?: string;
  lastUpdated?: string;
};

const {
  brand,
  description,
  copyright,
  social,
  builtWith,
  lastUpdatedLabel,
  lastUpdated,
} = Astro.props;
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-left">
        <span class="logo-text">{brand}</span>
        <p class="footer-desc">{description}</p>
        {builtWith ? <p class="footer-built">{builtWith}</p> : null}
        {
          lastUpdatedLabel && lastUpdated ? (
            <p class="footer-updated">
              <span>{lastUpdatedLabel}</span>
              <time datetime="2026-07">{lastUpdated}</time>
            </p>
          ) : null
        }
      </div>
      <div class="social-links">
        {
          social.map((item) =>
            item.wechat ? (
              <a href="#" class="wechat-link" id="footerWechatBtn">
                <Icon name={item.icon} />
                <span>{item.label}</span>
              </a>
            ) : (
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                <Icon name={item.icon} />
                <span>{item.label}</span>
              </a>
            ),
          )
        }
      </div>
    </div>
    <div class="footer-bottom">
      <p class="copyright">{copyright}</p>
    </div>
  </div>
</footer>
