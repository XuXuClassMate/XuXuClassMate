---
import Icon from "./Icon.astro";
import type { SocialLink } from "../content/types";
import { getPortfolioHome } from "../content/portfolio-home";
import { homeSurface } from "../content/chrome";
import { getCopy, pageHref, type Locale } from "../lib/i18n";

type Props = {
  locale?: Locale;
  brand: string;
  description: string;
  copyright: string;
  social: SocialLink[];
};

const { brand, description, social, locale = "en" } = Astro.props;
const copy = getCopy(locale);
const home = getPortfolioHome(locale);
const shopLinks = [
  { label: copy.nav.products ?? "Products", href: pageHref(locale, "work") },
  { label: "Live demo", href: home.ctaDemoHref },
  { label: copy.nav.openSource, href: pageHref(locale, "open-source") },
];
const learnLinks = [
  { label: copy.nav.engineering, href: pageHref(locale, "learn") },
  { label: copy.nav.notes, href: pageHref(locale, "blog") },
  { label: copy.nav.aiTesting, href: pageHref(locale, "ai-testing") },
];
const aboutLinks = [
  { label: copy.nav.about, href: pageHref(locale, "about") },
  { label: copy.nav.now, href: pageHref(locale, "now") },
  { label: "GitHub", href: "https://github.com/XuXuClassMate" },
];
const rightsReserved = "All rights reserved.";
const legalCopy = `Copyright © 2020-2026 ${brand}. ${rightsReserved}`;
const regionLabel = homeSurface(locale).location;
---

<footer class="footer footer--apple">
  <div class="container footer-apple-wrap">
    <p class="footer-apple-lead">{description}</p>
    <div class="footer-apple-grid">
      <div class="footer-apple-col">
        <h2 class="footer-apple-heading">Shop</h2>
        <ul>
          {shopLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="footer-apple-col">
        <h2 class="footer-apple-heading">Learn</h2>
        <ul>
          {learnLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="footer-apple-col">
        <h2 class="footer-apple-heading">About</h2>
        <ul>
          {aboutLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="footer-apple-col footer-apple-col--connect">
        <h2 class="footer-apple-heading">Connect</h2>
        <ul class="footer-apple-social">
          <li>
            <a class="contact-email" data-contact-mail href="/en/about"></a>
          </li>
          {
            social.map((item) => (
              <li>
                <a href={item.href} target="_blank" rel="noopener noreferrer">
                  <Icon name={item.icon} />
                  <span>{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="footer-bottom footer-apple-legal">
      <p class="footer-apple-region" data-footer-region hidden>
        <span class="sr-only">{regionLabel}</span>
        <span data-footer-region-name></span>
      </p>
      <p class="footer-apple-legal-line">
        <span class="footer-apple-legal-copy">{legalCopy}</span>
      </p>
    </div>
  </div>
  <script is:inline define:vars={{ footerLang: locale }}>
    (function () {
      const row = document.querySelector("[data-footer-region]");
      const nameEl = document.querySelector("[data-footer-region-name]");
      if (!row || !nameEl) return;
      fetch("/api/geo?lang=" + encodeURIComponent(footerLang), { credentials: "same-origin" })
        .then(function (res) {
          return res.ok ? res.json() : null;
        })
        .then(function (data) {
          if (!data || !data.country) return;
          const label =
            data.names && data.names[footerLang] != null
              ? data.names[footerLang]
              : data.name;
          if (!label) return;
          nameEl.textContent = label;
          row.hidden = false;
        })
        .catch(function () {});
    })();
  </script>
</footer>
