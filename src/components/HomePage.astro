---
import Footer from "./Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getLatestArticles,
  getPortfolioHome,
} from "../content/portfolio-home";
import { getCopy, pageHref, type Locale } from "../lib/i18n";

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const copy = getCopy(locale);
const home = getPortfolioHome(locale);
const blogHref = pageHref(locale, "blog");
const orgHref = pageHref(locale, "open-source");
const highlights = copy.home.highlights;
const [flagship, dockerFeatured] = home.featured;
const isZh = locale === "zh";
const pulls = highlights.find((item) => item.metric === "docker:total-pulls");
const learnMore = home.featuredMore;
const demoLabel = home.ctaDemo;
const buyLabel = isZh ? "体验" : "Try";
const articles = getLatestArticles(locale).slice(0, 4);
const serviceCover: Record<string, string> = {
  www: "/images/home/hero-product.jpg",
  nas: "/images/cover-docker.jpg",
  pulse: "/images/cover-globalpulse.jpg",
  mail: "/images/cover-custom-mail.jpg",
  watch: "/images/cover-globalpulse.jpg",
  ssh: "/images/cover-automation.jpg",
};
const entertainment = [
  ...articles.map((item) => ({
    title: item.title,
    detail: "",
    href: item.href,
    image: "/images/home/promo-notes.jpg",
  })),
  ...home.services.map((s) => ({
    title: s.title,
    detail: s.detail,
    href: s.href,
    image: serviceCover[s.id] ?? "/images/cover-docker.jpg",
  })),
];
---

<BaseLayout locale={locale} page="home">
  <section class="section section-ribbon">
    <div class="ribbon-wrapper">
      <p class="ribbon-copy">
        {isZh
          ? "在线试用 AI 测试用例生成器。"
          : "Shop the AI test case generator demo online."}
      </p>
      <a class="ribbon-link" href={home.ctaDemoHref}>
        {isZh ? "立即体验" : "Shop"}
        <span aria-hidden="true"> ›</span>
      </a>
    </div>
  </section>

  <main id="main-content" class="apple-home apple-com apple-homepage">
    {
      flagship && (
        <section class="section section-hero theme-dark" id="highlights">
          <div class="tile-wrapper">
            <a
              class="tile-link"
              href={flagship.href}
              aria-hidden="true"
              tabindex="-1"
            />
            <div class="tile-content">
              <div class="tile-copy-wrapper">
                <p class="tile-eyebrow hero-role-line">{home.heroKicker}</p>
                <h1 class="tile-headline hero-title">{flagship.title}</h1>
                <p class="tile-subhead">{flagship.pitch}</p>
                <p class="hero-desc sr-only">{home.description}</p>
              </div>
              <div class="tile-ctas hero-actions">
                <a class="apple-button btn-primary" href={flagship.href}>
                  {learnMore}
                </a>
                <a
                  class="apple-button apple-button-secondary btn-ghost"
                  href={home.ctaDemoHref}
                >
                  {buyLabel}
                </a>
              </div>
            </div>
            <div class="tile-image-wrapper">
              <img
                src="/images/home/hero-product.jpg"
                alt=""
                width="2560"
                height="2866"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </div>
          </div>
        </section>
      )
    }

    {
      dockerFeatured && (
        <section class="section section-promo theme-light">
          <div class="tile-wrapper">
            <a
              class="tile-link"
              href={dockerFeatured.href}
              aria-hidden="true"
              tabindex="-1"
            />
            <div class="tile-content">
              <div class="tile-copy-wrapper">
                <h2 class="tile-headline">{dockerFeatured.title}</h2>
                <p class="tile-subhead">
                  {isZh ? "多库 Docker，即开即用。" : "Test DB images. Ready to run."}
                </p>
              </div>
              <div class="tile-ctas">
                <a class="apple-button" href={dockerFeatured.href}>
                  {learnMore}
                </a>
                {pulls ? (
                  <a
                    class="apple-button apple-button-secondary"
                    href={pulls.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {pulls.linkLabel}
                  </a>
                ) : null}
              </div>
            </div>
            <div class="tile-image-wrapper">
              <img
                src="/images/home/promo-infra.jpg"
                alt=""
                width="2000"
                height="1333"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </section>
      )
    }

    <section class="section section-promo theme-dark">
      <div class="tile-wrapper">
        <div class="tile-content">
          <div class="tile-copy-wrapper">
            <h2 class="tile-headline">
              {isZh ? "生成式测试工程" : "Generative testing"}
            </h2>
            <p class="tile-subhead">
              {isZh
                ? "从需求到可评审用例。"
                : "From requirements to reviewable cases."}
            </p>
          </div>
          <div class="tile-ctas">
            <a class="apple-button" href={home.ctaDemoHref}>
              {demoLabel}
            </a>
            <a
              class="apple-button apple-button-secondary"
              href={home.connectGithub}
              target="_blank"
              rel="noopener noreferrer"
            >
              {home.ctaGithub}
            </a>
          </div>
        </div>
        <div class="tile-image-wrapper">
          <img
            src="/images/home/promo-cases.jpg"
            alt=""
            width="1280"
            height="800"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="section section-promo-duo" aria-label={isZh ? "精选" : "Featured"}>
      <article class="tile-wrapper theme-light">
        <a class="tile-link" href={orgHref} aria-hidden="true" tabindex="-1" />
        <div class="tile-content">
          <h2 class="tile-headline">{home.ossTitle}</h2>
          <div class="tile-ctas">
            <a class="apple-button" href={orgHref}>{home.ossOrgLabel}</a>
          </div>
        </div>
        <div class="tile-image-wrapper">
          <img src="/images/home/promo-docker-cover.jpg" alt="" width="800" height="450" loading="lazy" />
        </div>
      </article>
      <article class="tile-wrapper theme-light">
        <a class="tile-link" href={blogHref} aria-hidden="true" tabindex="-1" />
        <div class="tile-content">
          <h2 class="tile-headline">{home.articlesTitle}</h2>
          <div class="tile-ctas">
            <a class="apple-button" href={blogHref}>{home.articlesCta}</a>
          </div>
        </div>
        <div class="tile-image-wrapper">
          <img src="/images/home/promo-notes.jpg" alt="" width="1200" height="800" loading="lazy" />
        </div>
      </article>
    </section>

  </main>

  <section
    class="section section-entertainment"
    data-entertainment-gallery
    aria-label={isZh ? "工程内容与服务" : "Engineering & services"}
  >
    <div class="entertainment-header">
      <h2 class="entertainment-title">
        {isZh ? "持续更新的工程内容。" : "Endless engineering."}
      </h2>
    </div>
    <div class="entertainment-track" data-entertainment-track>
      <ul class="entertainment-list">
        {
          entertainment.map((item) => (
            <li class="entertainment-item">
              <a href={item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}>
                <div class="entertainment-art">
                  <img src={item.image} alt="" width="400" height="225" loading="lazy" />
                </div>
                <p class="entertainment-label">{item.title}</p>
                {item.detail ? (
                  <p class="entertainment-detail">{item.detail}</p>
                ) : null}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-services" id="services">
    <div class="container">
      <h2 class="section-title">{home.servicesTitle}</h2>
      <p class="section-lead">{home.servicesLead}</p>
      <ul class="service-directory">
        {
          home.services.map((item) => (
            <li>
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                <span class="service-directory-name">{item.title}</span>
                <span class="service-directory-detail">{item.detail}</span>
                <span class="service-directory-host">
                  {item.host}
                  <span aria-hidden="true">›</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Footer
    brand={copy.brand}
    description={copy.home.footerDesc}
    copyright={copy.copyright}
    social={copy.home.social}
  />
</BaseLayout>
