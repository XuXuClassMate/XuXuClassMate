---
import Footer from "./Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPortfolioHome } from "../content/portfolio-home";
import { getCopy, pageHref, type Locale } from "../lib/i18n";

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const copy = getCopy(locale);
const home = getPortfolioHome(locale);
const blogHref = pageHref(locale, "blog");
const orgHref = pageHref(locale, "open-source");
const highlights = copy.home.highlights;
const [flagship, dockerFeatured] = home.featured;
const pulls = highlights.find((item) => item.metric === "docker:total-pulls");
const learnMore = home.featuredMore;
const demoLabel = home.ctaDemo;
const isZh = locale === "zh";
const buyLabel = isZh ? "试用" : "Try";
---

<BaseLayout locale={locale} page="home">
  <section class="section section-ribbon">
    <div class="ribbon-wrapper">
      <p class="ribbon-copy">
        {isZh ? "AI 测试用例生成器演示已经就绪。" : "The AI test case generator demo is ready."}
      </p>
      <a class="ribbon-link" href={home.ctaDemoHref}>
        {isZh ? "试用" : "Try it"}
        <span aria-hidden="true">›</span>
      </a>
    </div>
  </section>

  <main id="main-content" class="apple-home apple-com apple-homepage">
    {
      flagship && (
        <section class="section section-hero theme-dark" id="highlights">
          <div class="tile-wrapper">
            <a
              class="tile-link"
              href={flagship.href}
              aria-hidden="true"
              tabindex="-1"
            />
            <div class="tile-content">
              <div class="tile-copy-wrapper">
                <p class="tile-eyebrow hero-role-line">{home.heroKicker}</p>
                <h1 class="tile-headline hero-title">{flagship.title}</h1>
                <p class="tile-subhead">{flagship.pitch}</p>
                <p class="hero-desc sr-only">{home.description}</p>
              </div>
              <div class="tile-ctas hero-actions">
                <a class="apple-button btn-primary" href={flagship.href}>
                  {learnMore}
                </a>
                <a
                  class="apple-button apple-button-secondary btn-ghost"
                  href={home.ctaDemoHref}
                >
                  {buyLabel}
                </a>
              </div>
            </div>
            <div class="tile-image-wrapper">
              <img
                src="/images/home/hero-main.jpg"
                alt=""
                width="2560"
                height="2866"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </div>
          </div>
        </section>
      )
    }

    {
      dockerFeatured && (
        <section class="section section-promo theme-light">
          <div class="tile-wrapper">
            <a
              class="tile-link"
              href={dockerFeatured.href}
              aria-hidden="true"
              tabindex="-1"
            />
            <div class="tile-content">
              <div class="tile-copy-wrapper">
                <h2 class="tile-headline">{dockerFeatured.title}</h2>
                <p class="tile-subhead">
                  {isZh ? "测试数据库镜像。开箱即用。" : "Test DB images. Ready to run."}
                </p>
              </div>
              <div class="tile-ctas">
                <a class="apple-button" href={dockerFeatured.href}>
                  {learnMore}
                </a>
                {pulls ? (
                  <a
                    class="apple-button apple-button-secondary"
                    href={pulls.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Docker Hub
                  </a>
                ) : null}
              </div>
            </div>
            <div class="tile-image-wrapper">
              <img
                src="/images/home/promo-infra.jpg"
                alt=""
                width="2000"
                height="1333"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </section>
      )
    }

    <section class="section section-promo theme-dark">
      <div class="tile-wrapper">
        <div class="tile-content">
          <div class="tile-copy-wrapper">
            <h2 class="tile-headline">
              {isZh ? "生成式测试" : "Generative testing"}
            </h2>
            <p class="tile-subhead">
              {isZh ? "从需求到可评审的用例。" : "From requirements to reviewable cases."}
            </p>
          </div>
          <div class="tile-ctas">
            <a class="apple-button" href={home.ctaDemoHref}>
              {demoLabel}
            </a>
            <a
              class="apple-button apple-button-secondary"
              href={home.connectGithub}
              target="_blank"
              rel="noopener noreferrer"
            >
              {home.ctaGithub}
            </a>
          </div>
        </div>
        <div class="tile-image-wrapper">
          <img
            src="/images/home/promo-cases.jpg"
            alt=""
            width="1280"
            height="800"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="section section-promo-duo" aria-label="Featured">
      <article class="tile-wrapper theme-light">
        <a class="tile-link" href={orgHref} aria-hidden="true" tabindex="-1" />
        <div class="tile-content">
          <h2 class="tile-headline">{home.ossTitle}</h2>
          <div class="tile-ctas">
            <a class="apple-button" href={orgHref}>{home.ossOrgLabel}</a>
          </div>
        </div>
        <div class="tile-image-wrapper">
          <img src="/images/home/promo-flagship.jpg" alt="" width="800" height="450" loading="lazy" />
        </div>
      </article>
      <article class="tile-wrapper theme-light">
        <a class="tile-link" href={blogHref} aria-hidden="true" tabindex="-1" />
        <div class="tile-content">
          <h2 class="tile-headline">{home.articlesTitle}</h2>
          <div class="tile-ctas">
            <a class="apple-button" href={blogHref}>{home.articlesCta}</a>
          </div>
        </div>
        <div class="tile-image-wrapper">
          <img src="/images/home/promo-notes.jpg" alt="" width="1200" height="800" loading="lazy" />
        </div>
      </article>
    </section>

  </main>

  <Footer
    locale={locale}
    brand={copy.brand}
    description={copy.home.footerDesc}
    copyright={copy.copyright}
    social={copy.home.social}
  />
</BaseLayout>
