---
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import WechatModal from "./WechatModal.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCopy } from "../lib/i18n";
import type { Locale } from "../lib/i18n";

type Props = {
  locale: Locale;
  rootHome?: boolean;
};

const { locale, rootHome = false } = Astro.props;
const copy = getCopy(locale);
const { home } = copy;
---

<BaseLayout locale={locale} page="home" rootHome={rootHome}>
  <main>
    <section class="hero hero--home">
      <div class="hero-blob" aria-hidden="true"></div>
      <div class="hero-atmosphere" aria-hidden="true"></div>
      <div class="container">
        <div class="hero-content reveal">
          <p class="hero-brand">{copy.brand}</p>
          <p class="subtitle subtitle--type" data-typewriter>{home.subtitle}</p>
          <h1 class="hero-title">{home.title}</h1>
          <p class="hero-desc">{home.description}</p>
          <div class="hero-actions">
            <a class="btn-primary" href={home.links[1]?.href ?? "/en/work.html"}>
              {home.links[1]?.title ?? "Work"}
            </a>
            <a class="btn-ghost" href={home.links[0]?.href ?? "/en/learn.html"}>
              {home.links[0]?.title ?? "Learn"}
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="highlights">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{home.highlightsTitle}</h2>
        <div class="highlights-grid">
          {
            home.highlights.map((item, index) => (
              <div
                class={`highlight-card reveal-on-scroll reveal-delay-${(index % 3) + 1}`}
              >
                <span class="highlight-value" data-count-to={item.value}>
                  {item.value}
                </span>
                <span class="highlight-label">{item.label}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="values">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{home.valuesTitle}</h2>
        <div class="values-grid">
          {
            home.values.map((item, index) => (
              <div
                class={`value-card reveal-on-scroll reveal-delay-${index + 1}`}
              >
                <span class="value-index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-featured">
      <div class="container">
        <div class="section-head reveal-on-scroll">
          <h2 class="section-title">{home.featuredTitle}</h2>
          <a class="section-cta" href={home.links[1]?.href}>
            {home.featuredCta}
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="project-grid project-grid--home">
          {
            home.featured.map((item, index) => (
              <article
                class={`project-card featured reveal-on-scroll reveal-delay-${index + 1}`}
              >
                <div class="project-content">
                  {item.category ? (
                    <span class="project-category">{item.category}</span>
                  ) : null}
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                  <div class="project-tech">
                    {item.tags?.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                  <div class="project-links">
                    <a
                      href={item.href}
                      class="project-link"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {item.linkLabel}
                    </a>
                    {item.ctaHref && item.ctaLabel ? (
                      <a
                        href={item.ctaHref}
                        class="project-link project-link--secondary"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {item.ctaLabel}
                      </a>
                    ) : null}
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="principles">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{home.principlesTitle}</h2>
        <div class="principles-grid">
          {
            home.principles.map((item, index) => (
              <div
                class={`principle-card reveal-on-scroll reveal-delay-${index + 1}`}
              >
                <span class="principle-index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="channels">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{home.channelsTitle}</h2>
        <div class="channels-grid">
          {
            home.channels.map((item, index) => (
              <a
                href={item.href}
                class={`channel-card reveal-on-scroll reveal-delay-${index + 1}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.icon ? <i class={item.icon} aria-hidden="true" /> : null}
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <span class="channel-cta">
                  {item.linkLabel}
                  <span aria-hidden="true">→</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="quick-links">
      <div class="container">
        <div class="links-grid">
          {
            home.links.map((item, index) => (
              <a
                href={item.href}
                class={`link-card reveal-on-scroll reveal-delay-${index + 1}`}
              >
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <span class="link-card-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Contact
    label={copy.contactLabel}
    hint={copy.contactHint}
    copyLabel={copy.copyEmail}
    copiedLabel={copy.copiedEmail}
  />
  <Footer
    brand={copy.brand}
    description={home.footerDesc}
    copyright={copy.copyright}
    social={home.social}
  />
  <WechatModal alt={copy.wechatAlt} />
</BaseLayout>
