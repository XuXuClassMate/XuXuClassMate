---
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import Icon from "./Icon.astro";
import PageHero from "./PageHero.astro";
import ProjectCard from "./ProjectCard.astro";
import WechatModal from "./WechatModal.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCopy } from "../lib/i18n";
import { getMetrics, resolveMetric } from "../lib/metrics";
import type { IconName } from "../content/types";
import type { Locale } from "../lib/i18n";

type Props = {
  locale: Locale;
  rootHome?: boolean;
};

const { locale, rootHome = false } = Astro.props;
const copy = getCopy(locale);
const { home } = copy;
const metrics = await getMetrics();
---

<BaseLayout locale={locale} page="home" rootHome={rootHome}>
  <main id="main-content">
    <PageHero
      home
      brand={copy.brand}
      subtitle={home.subtitle}
      title={home.title}
      description={home.description}
      typewriter
      actions={[
        {
          href: home.links[1]?.href ?? "/en/work.html",
          label: home.links[1]?.title ?? "Work",
          primary: true,
        },
        {
          href: home.links[0]?.href ?? "/en/learn.html",
          label: home.links[0]?.title ?? "Learn",
        },
      ]}
    />

    <section class="highlights">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{home.highlightsTitle}</h2>
        <div class="highlights-grid">
          {
            home.highlights.map((item, index) => {
              const value = resolveMetric(metrics, item.metric, item.value);
              return (
                <div
                  class={`highlight-card reveal-on-scroll reveal-delay-${(index % 3) + 1}`}
                >
                  <span
                    class="highlight-value"
                    data-count-to={value}
                    data-metric={item.metric}
                    data-metric-fallback={item.value}
                  >
                    {value}
                  </span>
                  <span class="highlight-label">{item.label}</span>
                </div>
              );
            })
          }
        </div>
      </div>
    </section>

    <section class="values">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{home.valuesTitle}</h2>
        <div class="values-grid">
          {
            home.values.map((item, index) => (
              <div
                class={`value-card reveal-on-scroll reveal-delay-${index + 1}`}
              >
                <span class="value-index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-featured">
      <div class="container">
        <div class="section-head reveal-on-scroll">
          <h2 class="section-title">{home.featuredTitle}</h2>
          <a class="section-cta" href={home.links[1]?.href}>
            {home.featuredCta}
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="project-grid project-grid--home">
          {
            home.featured.map((item, index) => (
              <ProjectCard item={item} index={index} />
            ))
          }
        </div>
      </div>
    </section>

    <section class="principles">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{home.principlesTitle}</h2>
        <div class="principles-grid">
          {
            home.principles.map((item, index) => (
              <div
                class={`principle-card reveal-on-scroll reveal-delay-${index + 1}`}
              >
                <span class="principle-index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="channels">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{home.channelsTitle}</h2>
        <div class="channels-grid">
          {
            home.channels.map((item, index) => (
              <a
                href={item.href}
                class={`channel-card reveal-on-scroll reveal-delay-${index + 1}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.icon ? (
                  <Icon name={item.icon as IconName} class="channel-icon" />
                ) : null}
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <span class="channel-cta">
                  {item.linkLabel}
                  <span aria-hidden="true">→</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="quick-links">
      <div class="container">
        <div class="links-grid">
          {
            home.links.map((item, index) => (
              <a
                href={item.href}
                class={`link-card reveal-on-scroll reveal-delay-${index + 1}`}
              >
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <span class="link-card-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Contact
    label={copy.contactLabel}
    hint={copy.contactHint}
    copyLabel={copy.copyEmail}
    copiedLabel={copy.copiedEmail}
  />
  <Footer
    brand={copy.brand}
    description={home.footerDesc}
    copyright={copy.copyright}
    social={home.social}
  />
  <WechatModal alt={copy.wechatAlt} closeLabel={copy.closeModal} />
</BaseLayout>
