---
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getLatestArticles,
  getPortfolioHome,
} from "../content/portfolio-home";
import { getCopy, pageHref, type Locale } from "../lib/i18n";
import { getMetrics, resolveMetric } from "../lib/metrics";

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const copy = getCopy(locale);
const home = getPortfolioHome(locale);
const articles = getLatestArticles(locale).slice(0, 2);
const blogHref = pageHref(locale, "blog");
const orgHref = pageHref(locale, "open-source");
const metrics = await getMetrics();
const highlights = copy.home.highlights;
const [flagship, ...moreFeatured] = home.featured;
const isZh = locale === "zh";
const pulls = highlights.find((item) => item.metric === "docker:total-pulls");
const clawhub = highlights.find(
  (item) => item.metric === "clawhub:total-downloads",
);
const coverage = home.achievements[0];
const qps = home.achievements[1];
const impactNote = isZh
  ? "Docker 与 ClawHub 是公开累计，每日更新。覆盖率和 QPS 来自过往交付，不是实时计数。"
  : "Docker and ClawHub totals are public and updated daily. Coverage and QPS are from past delivery work, not live counters.";
const dockerFeatured = moreFeatured[0];
const dbNames = isZh
  ? ["达梦", "瀚高", "人大金仓", "TiDB"]
  : ["Dameng", "Highgo", "Kingbase", "TiDB"];
---

<BaseLayout locale={locale} page="home">
  <main id="main-content" class="apple-home apple-com">
    <section class="ac-hero hero hero--home" id="top">
      <div class="ac-hero-inner">
        <p class="ac-eyebrow">{home.heroKicker}</p>
        <h1 class="hero-title">{home.greeting}</h1>
        <p class="hero-desc">{home.description}</p>
        <div class="hero-actions">
          <a class="btn-primary" href="#featured">
            {home.ctaWork}
            <span aria-hidden="true">›</span>
          </a>
          <a
            class="btn-ghost"
            href={home.connectGithub}
            target="_blank"
            rel="noopener noreferrer"
          >
            {home.ctaGithub}
            <span aria-hidden="true">›</span>
          </a>
        </div>
      </div>
      <div class="ac-hero-stage">
        <picture>
          <source
            type="image/jpeg"
            media="(prefers-color-scheme: dark)"
            srcset="/images/home/hero-main.jpg"
          />
          <img
            src="/images/home/hero-main.jpg"
            alt={isZh
              ? "笔记本电脑上的开发与测试工作区"
              : "A laptop workspace for development and testing"}
            width="2400"
            height="1600"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
    </section>

    <section class="ac-promo" id="featured">
      <div class="ac-promo-copy">
        <h2 class="ac-eyebrow">{home.featuredTitle}</h2>
        {flagship ? <p class="ac-product-name">{flagship.title}</p> : null}
        {flagship?.pitch ? (
          <p class="ac-product-tagline">{flagship.pitch}</p>
        ) : null}
        {
          flagship && (
            <ul class="ac-cta-row">
              <li>
                <a href={home.ctaDemoHref}>
                  {home.ctaDemo}
                  <span aria-hidden="true">›</span>
                </a>
              </li>
              <li>
                <a href={flagship.href}>
                  {home.featuredMore}
                  <span aria-hidden="true">›</span>
                </a>
              </li>
            </ul>
          )
        }
        {flagship?.flow ? (
          <p class="ac-flow">{flagship.flow.join("  ·  ")}</p>
        ) : null}
      </div>
      <figure class="ac-promo-figure">
        <img
          src="/images/home/promo-flagship.jpg"
          alt={isZh
            ? "生成式 AI 与测试工程"
            : "Generative AI and test engineering"}
          width="2000"
          height="1333"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </section>

    {
      dockerFeatured && (
        <section class="ac-promo ac-promo--inset" id="selected">
          <div class="ac-promo-copy">
            <h2 class="ac-eyebrow">
              {isZh ? "测试基础设施" : "Test infrastructure"}
            </h2>
            <p class="ac-product-name">{dockerFeatured.title}</p>
            <p class="ac-product-tagline">{dockerFeatured.description}</p>
            <ul class="ac-cta-row">
              <li>
                <a href={dockerFeatured.href}>
                  {home.featuredMore}
                  <span aria-hidden="true">›</span>
                </a>
              </li>
              {pulls ? (
                <li>
                  <a
                    href={pulls.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {pulls.linkLabel}
                    <span aria-hidden="true">›</span>
                  </a>
                </li>
              ) : null}
            </ul>
            <ul class="ac-chip-row">
              {dbNames.map((name) => (
                <li>{name}</li>
              ))}
            </ul>
          </div>
          <figure class="ac-promo-figure">
            <img
              src="/images/home/promo-infra.jpg"
              alt={isZh
                ? "数据中心与容器化测试环境"
                : "Data center and containerized test environments"}
              width="2000"
              height="1333"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </section>
      )
    }

    <section class="ac-metrics" id="by-the-numbers">
      <h2>{copy.home.highlightsTitle}</h2>
      <p class="ac-lead">{copy.home.highlightsSubtitle}</p>
      <p class="ac-note">{impactNote}</p>
      <div class="ac-metrics-grid impact-row">
        {
          pulls && (
            <article>
              <span
                class="impact-value"
                data-metric={pulls.metric}
                data-metric-fallback={pulls.value}
              >
                {resolveMetric(metrics, pulls.metric, pulls.value)}
              </span>
              <span class="impact-label">{pulls.label}</span>
              <a href={pulls.href} target="_blank" rel="noopener noreferrer">
                {pulls.linkLabel}
              </a>
            </article>
          )
        }
        {
          clawhub && (
            <article>
              <span
                class="impact-value"
                data-metric={clawhub.metric}
                data-metric-fallback={clawhub.value}
              >
                {resolveMetric(metrics, clawhub.metric, clawhub.value)}
              </span>
              <span class="impact-label">{clawhub.label}</span>
              <a href={clawhub.href} target="_blank" rel="noopener noreferrer">
                {clawhub.linkLabel}
              </a>
            </article>
          )
        }
        {
          coverage && (
            <article>
              <span class="impact-value">{coverage.value}</span>
              <span class="impact-label">{coverage.label}</span>
            </article>
          )
        }
        {
          qps && (
            <article>
              <span class="impact-value">{qps.value}</span>
              <span class="impact-label">{qps.label}</span>
            </article>
          )
        }
      </div>
    </section>

    <section class="ac-bento" aria-label={isZh ? "更多入口" : "More"}>
      <a class="ac-bento-tile" id="opensource" href={orgHref}>
        <h2>{home.ossTitle}</h2>
        <p>{home.ossDescription}</p>
        <span class="ac-bento-cta">
          {home.ossOrgLabel}
          <span aria-hidden="true"> ›</span>
        </span>
        <div class="ac-bento-media">
          <img
            src="/images/cover-docker.jpg"
            alt=""
            width="800"
            height="450"
            loading="lazy"
            decoding="async"
          />
        </div>
      </a>
      <a
        class="ac-bento-tile"
        id="articles"
        href={blogHref}
      >
        <h2>{home.articlesTitle}</h2>
        <p>
          {isZh
            ? "工程笔记与交付复盘，按产品页节奏阅读。"
            : "Engineering notes and delivery write-ups, sized for calm reading."}
        </p>
        <span class="ac-bento-cta">
          {home.articlesCta}
          <span aria-hidden="true"> ›</span>
        </span>
        <div class="ac-bento-media">
          <img
            src="/images/home/promo-notes.jpg"
            alt=""
            width="1200"
            height="800"
            loading="lazy"
            decoding="async"
          />
        </div>
      </a>
    </section>

    <div class="ac-articles">
      <div class="ac-articles-inner note-rows">
        {
          articles.map((item) => (
            <a href={item.href}>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </main>

  <Contact
    label={copy.contactLabel}
    hint={copy.contactHint}
    offers={copy.contactOffers}
    copyLabel={copy.copyEmail}
    copiedLabel={copy.copiedEmail}
  />
  <Footer
    brand={copy.brand}
    description={copy.home.footerDesc}
    copyright={copy.copyright}
    social={copy.home.social}
  />
</BaseLayout>
