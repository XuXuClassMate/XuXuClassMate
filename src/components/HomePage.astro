---
import Footer from "./Footer.astro";
import WechatModal from "./WechatModal.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getLatestArticles,
  getPortfolioHome,
} from "../content/portfolio-home";
import { getCopy, pageHref, type Locale } from "../lib/i18n";
import { CONTACT_EMAIL } from "../lib/i18n";
import { getMetrics, resolveMetric } from "../lib/metrics";

type Props = {
  locale: Locale;
  rootHome?: boolean;
};

const { locale, rootHome = false } = Astro.props;
const copy = getCopy(locale);
const home = getPortfolioHome(locale);
const articles = getLatestArticles(locale);
const workHref = pageHref(locale, "work");
const blogHref = pageHref(locale, "blog");
const orgHref = pageHref(locale, "open-source");
const metrics = await getMetrics();
const highlights = copy.home.highlights;
---

<BaseLayout locale={locale} page="home" rootHome={rootHome}>
  <main id="main-content">
    <section class="hero hero--home hero--signature">
      <div class="hero-blob" aria-hidden="true"></div>
      <div class="hero-atmosphere" aria-hidden="true"></div>
      <div class="container">
        <div class="hero-content reveal">
          <p class="hero-brand">{copy.brand}</p>
          <h1 class="hero-title">{home.greeting}</h1>
          <p class="hero-role-line">{home.roles.join(" · ")}</p>
          <p class="hero-tagline">{home.tagline}</p>
          <p class="hero-desc">{home.description}</p>
          <div class="hero-actions">
            <a class="btn-primary" href={workHref}>{home.ctaWork}</a>
            <a
              class="btn-ghost"
              href={home.connectGithub}
              target="_blank"
              rel="noopener noreferrer">{home.ctaGithub}</a
            >
            <a class="btn-ghost" href="#contact">{home.ctaContact}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="home-section what-i-do" id="what-i-do">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{home.whatIDoTitle}</h2>
        <ul class="capability-list reveal-on-scroll">
          {
            home.whatIDo.map((item) => (
              <li>
                <a href={item.href}>{item.title}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="highlights home-section" id="by-the-numbers">
      <div class="container">
        <div class="section-head reveal-on-scroll">
          <div>
            <h2 class="section-title">{copy.home.highlightsTitle}</h2>
            <p class="highlights-subtitle">{copy.home.highlightsSubtitle}</p>
            <p class="highlights-proof">{copy.home.highlightsProof}</p>
          </div>
        </div>
        <div class="highlights-grid">
          {
            highlights.map((item, index) => {
              const value = resolveMetric(metrics, item.metric, item.value);
              const cardClass = `highlight-card reveal-on-scroll reveal-delay-${(index % 4) + 1}`;
              const valueAttrs = item.metric
                ? {
                    "data-metric": item.metric,
                    "data-metric-fallback": item.value,
                    "data-count-to": value,
                  }
                : { "data-count-to": value };
              return (
                <article class={cardClass}>
                  <span class="highlight-value" {...valueAttrs}>
                    {value}
                  </span>
                  <span class="highlight-label">{item.label}</span>
                  {item.href && item.linkLabel ? (
                    <a
                      class="highlight-source"
                      href={item.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {item.linkLabel}
                    </a>
                  ) : null}
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <section class="principles home-section" id="principles">
      <div class="container">
        <div class="section-head reveal-on-scroll">
          <div>
            <h2 class="section-title">{copy.home.principlesTitle}</h2>
            <p class="principles-lead">{copy.home.principlesLead}</p>
          </div>
        </div>
        <div class="principles-grid principles-grid--five">
          {
            copy.home.principles.map((item, index) => (
              <article
                class={`principle-card reveal-on-scroll reveal-delay-${(index % 5) + 1}`}
              >
                <span class="principle-index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-section key-achievements" id="achievements">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{home.achievementsTitle}</h2>
        <div class="achievements-grid">
          {
            home.achievements.map((item, index) => (
              <div
                class={`achievement-card reveal-on-scroll reveal-delay-${(index % 4) + 1}`}
              >
                <span class="achievement-value">{item.value}</span>
                <span class="achievement-label">{item.label}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-section home-featured" id="featured">
      <div class="container">
        <div class="section-head reveal-on-scroll">
          <h2 class="section-title">{home.featuredTitle}</h2>
          <a class="section-cta" href={workHref}>
            {home.featuredCta}
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="featured-list">
          {
            home.featured.map((item, index) => (
              <a
                href={item.href}
                class={`featured-row reveal-on-scroll reveal-delay-${(index % 3) + 1}`}
                target={item.href.startsWith("http") ? "_blank" : undefined}
                rel={
                  item.href.startsWith("http")
                    ? "noopener noreferrer"
                    : undefined
                }
              >
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                  <ul class="featured-tags">
                    {item.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                </div>
                <span class="featured-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-section tech-stack" id="stack">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{home.stackTitle}</h2>
        <ul class="stack-list reveal-on-scroll">
          {home.stack.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="home-section latest-articles" id="articles">
      <div class="container">
        <div class="section-head reveal-on-scroll">
          <h2 class="section-title">{home.articlesTitle}</h2>
          <a class="section-cta" href={blogHref}>
            {home.articlesCta}
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="article-list">
          {
            articles.map((item, index) => (
              <a
                href={item.href}
                class={`article-row reveal-on-scroll reveal-delay-${(index % 3) + 1}`}
              >
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-section oss-section" id="opensource">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{home.ossTitle}</h2>
        <p class="section-lead reveal-on-scroll">{home.ossDescription}</p>
        <div class="oss-actions reveal-on-scroll">
          <a
            class="btn-primary"
            href={home.connectGithub}
            target="_blank"
            rel="noopener noreferrer">{home.ossGithubLabel}</a
          >
          <a class="btn-ghost" href={orgHref}>{home.ossOrgLabel}</a>
        </div>
      </div>
    </section>

    <section class="home-section connect-section" id="contact">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{home.connectTitle}</h2>
        <div class="connect-links reveal-on-scroll">
          <a
            href={home.connectGithub}
            target="_blank"
            rel="noopener noreferrer">GitHub</a
          >
          <a href={`mailto:${CONTACT_EMAIL}`}>Email</a>
        </div>
        <p class="connect-email reveal-on-scroll">
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        </p>
      </div>
    </section>
  </main>

  <Footer
    brand={copy.brand}
    description={copy.home.footerDesc}
    copyright={copy.copyright}
    social={copy.home.social}
  />
  <WechatModal alt={copy.wechatAlt} closeLabel={copy.closeModal} />
</BaseLayout>
