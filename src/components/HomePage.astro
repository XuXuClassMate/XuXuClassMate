---
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getLatestArticles,
  getPortfolioHome,
} from "../content/portfolio-home";
import { getCopy, pageHref, type Locale } from "../lib/i18n";
import { getMetrics, resolveMetric } from "../lib/metrics";

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const copy = getCopy(locale);
const home = getPortfolioHome(locale);
const articles = getLatestArticles(locale).slice(0, 2);
const blogHref = pageHref(locale, "blog");
const orgHref = pageHref(locale, "open-source");
const metrics = await getMetrics();
const highlights = copy.home.highlights;
const [flagship, ...moreFeatured] = home.featured;
const isZh = locale === "zh";
const pulls = highlights.find((item) => item.metric === "docker:total-pulls");
const clawhub = highlights.find(
  (item) => item.metric === "clawhub:total-downloads",
);
const coverage = home.achievements[0];
const qps = home.achievements[1];
const impactNote = isZh
  ? "Docker 与 ClawHub 是公开累计，每日更新。覆盖率和 QPS 来自过往交付，不是实时计数。"
  : "Docker and ClawHub totals are public and updated daily. Coverage and QPS are from past delivery work, not live counters.";
---

<BaseLayout locale={locale} page="home">
  <main id="main-content" class="apple-home">
    <section class="tile tile--hero hero hero--home">
      <div class="tile-copy hero-copy">
        <p class="hero-role-line">{home.heroKicker}</p>
        <h1 class="hero-title">{home.greeting}</h1>
        <p class="hero-desc">{home.description}</p>
        <div class="hero-actions">
          <a class="btn-primary" href="#featured">
            {home.ctaWork}
            <span aria-hidden="true">›</span>
          </a>
          <a
            class="btn-ghost"
            href={home.connectGithub}
            target="_blank"
            rel="noopener noreferrer"
          >
            {home.ctaGithub}
            <span aria-hidden="true">›</span>
          </a>
        </div>
      </div>
      <figure class="hero-visual">
        <div class="device showcase">
          <div class="device-bar" aria-hidden="true"><span></span><span></span><span></span></div>
          <img
            src="/images/product-generator-workspace.jpg"
            alt={isZh
              ? "交互 Demo 跑完后的需求、用例、审核和导出"
              : "The interactive demo after a run: requirement, cases, review, and export"}
            width="2560"
            height="2866"
          />
        </div>
      </figure>
    </section>

    <section class="tile tile--paper store-billboard" id="featured">
      <div class="tile-copy">
        <h2 class="tile-kicker">{home.featuredTitle}</h2>
        {flagship ? <p class="store-name">{flagship.title}</p> : null}
        {flagship?.pitch ? <p class="tile-statement">{flagship.pitch}</p> : null}
      </div>
      {
        flagship && (
          <p class="band-links">
            <a href={home.ctaDemoHref}>{home.ctaDemo}<span aria-hidden="true">›</span></a>
            <a href={flagship.href}>
              {home.featuredMore}
              <span aria-hidden="true">›</span>
            </a>
          </p>
        )
      }
      {
        flagship?.flow && (
          <p class="store-flow">{flagship.flow.join("  ·  ")}</p>
        )
      }
      <figure class="store-shot">
        <img
          src="/images/product-generator-cases.jpg"
          alt={isZh ? "生成后的测试用例" : "Generated test cases"}
          width="1280"
          height="800"
        />
      </figure>
    </section>

    <section class="tile tile--paper store-billboard" id="selected">
      {
        moreFeatured.map((item) => (
          <div class="tile-copy">
            <h2 class="store-name">{item.title}</h2>
            <p class="tile-statement">{item.description}</p>
            <p class="band-links">
              <a href={item.href}>
                {home.featuredMore}
                <span aria-hidden="true">›</span>
              </a>
              {
                pulls && (
                  <a href={pulls.href} target="_blank" rel="noopener noreferrer">
                    {pulls.linkLabel}
                  </a>
                )
              }
            </p>
          </div>
        ))
      }
      <ul class="db-home">
        {(isZh
          ? ["达梦", "瀚高", "人大金仓", "TiDB"]
          : ["Dameng", "Highgo", "Kingbase", "TiDB"]
        ).map((name) => (
          <li>{name}</li>
        ))}
      </ul>
      <figure class="store-shot">
        <img
          src="/images/product-stage-databases.png"
          alt={isZh ? "一组数据库环境" : "A row of database environments"}
          width="1022"
          height="244"
        />
      </figure>
    </section>

    <section class="tile tile--paper" id="by-the-numbers">
      <div class="tile-copy">
        <h2>{copy.home.highlightsTitle}</h2>
        <p class="highlights-subtitle">{copy.home.highlightsSubtitle}</p>
        <p class="band-note">{impactNote}</p>
      </div>
      <div class="impact-row">
        {
          pulls && (
            <article>
              <span
                class="impact-value"
                data-metric={pulls.metric}
                data-metric-fallback={pulls.value}
              >
                {resolveMetric(metrics, pulls.metric, pulls.value)}
              </span>
              <span class="impact-label">{pulls.label}</span>
              <a href={pulls.href} target="_blank" rel="noopener noreferrer">
                {pulls.linkLabel}
              </a>
            </article>
          )
        }
        {
          clawhub && (
            <article>
              <span
                class="impact-value"
                data-metric={clawhub.metric}
                data-metric-fallback={clawhub.value}
              >
                {resolveMetric(metrics, clawhub.metric, clawhub.value)}
              </span>
              <span class="impact-label">{clawhub.label}</span>
              <a href={clawhub.href} target="_blank" rel="noopener noreferrer">
                {clawhub.linkLabel}
              </a>
            </article>
          )
        }
        {
          coverage && (
            <article>
              <span class="impact-value">{coverage.value}</span>
              <span class="impact-label">{coverage.label}</span>
            </article>
          )
        }
        {
          qps && (
            <article>
              <span class="impact-value">{qps.value}</span>
              <span class="impact-label">{qps.label}</span>
            </article>
          )
        }
      </div>
    </section>

    <div class="store-grid">
    <section class="closer" id="opensource">
      <div class="tile-copy">
        <h2>{home.ossTitle}</h2>
        <p class="band-lead">{home.ossDescription}</p>
        <p class="band-links">
          <a href={home.connectGithub} target="_blank" rel="noopener noreferrer">
            {home.ossGithubLabel}
            <span aria-hidden="true">›</span>
          </a>
          <a href={orgHref}>
            {home.ossOrgLabel}
            <span aria-hidden="true">›</span>
          </a>
        </p>
      </div>
    </section>

    <section class="closer closer--notes" id="articles">
      <div class="tile-copy band-copy--row">
        <h2>{home.articlesTitle}</h2>
        <a href={blogHref}>
          {home.articlesCta}
          <span aria-hidden="true">›</span>
        </a>
      </div>
      <figure class="tile-stage">
        <img
          src="/images/product-stage-notes.jpg"
          alt={isZh
            ? "两本合上的笔记本和一支铅笔"
            : "Two closed notebooks and a pencil"}
          width="1280"
          height="720"
        />
      </figure>
      <div class="note-rows">
        {
          articles.map((item) => (
            <a href={item.href}>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </a>
          ))
        }
      </div>
    </section>
    </div>
  </main>

  <Contact
    label={copy.contactLabel}
    hint={copy.contactHint}
    offers={copy.contactOffers}
    copyLabel={copy.copyEmail}
    copiedLabel={copy.copiedEmail}
  />
  <Footer
    brand={copy.brand}
    description={copy.home.footerDesc}
    copyright={copy.copyright}
    social={copy.home.social}
  />
</BaseLayout>
