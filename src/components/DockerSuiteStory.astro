---
import BackNav from "./BackNav.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCase, getCopy, pageHref, type Locale } from "../lib/i18n";
import { getMetrics, resolveMetric } from "../lib/metrics";

type Props = { locale: Locale };

const { locale } = Astro.props;
const isZh = locale === "zh";
const copy = getCopy(locale);
const page = copy.work;
const study = getCase(locale, "docker-suite");
const metrics = await getMetrics();
const workHref = pageHref(locale, "work");

if (!study) {
  throw new Error("Missing docker-suite case");
}

const databases = isZh
  ? ["达梦", "瀚高", "人大金仓", "TiDB"]
  : ["Dameng", "Highgo", "Kingbase", "TiDB"];
---

<BaseLayout locale={locale} page="work" caseSlug="docker-suite" ogImagePath={study.cover} metaOverride={study.meta}>
  <main id="main-content" class="story story--infra">
    <section class="story-hero story-hero--infra">
      <div class="story-wrap">
        <BackNav href={workHref} label={page.caseBackLabel} />
        <p class="subtitle">{isZh ? "基础设施" : "INFRASTRUCTURE"}</p>
        <h1>{study.title}</h1>
        <p class="story-lead">{study.description}</p>
      </div>
    </section>

    <section class="story-band">
      <div class="story-wrap">
        <h2>{isZh ? "支持的数据库" : "Supported Databases"}</h2>
        <ul class="db-row">
          {databases.map((name) => <li>{name}</li>)}
        </ul>
        <ul class="story-plain">
          {study.features?.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="story-band story-band--proof">
      <div class="story-wrap">
        <h2>{isZh ? "拉取数据" : "Pull Statistics"}</h2>
        <div class="story-metrics">
          {
            study.metrics.map((metric) => (
              <article>
                <span
                  {...(metric.metric
                    ? {
                        "data-metric": metric.metric,
                        "data-metric-fallback": metric.value,
                      }
                    : {})}
                >
                  {resolveMetric(metrics, metric.metric, metric.value)}
                </span>
                <p>{metric.label}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="story-band">
      <div class="story-wrap">
        <h2>{isZh ? "快速开始" : "Quick Start"}</h2>
        {study.deployment?.summary ? <p class="story-lead">{study.deployment.summary}</p> : null}
        <pre class="story-command"><code>docker pull xuxuclassmate/dameng
docker pull xuxuclassmate/highgo
docker pull xuxuclassmate/kingbase
docker pull xuxuclassmate/tidb</code></pre>
        <ol class="story-steps">
          {study.deployment?.steps.map((step) => <li>{step}</li>)}
        </ol>
      </div>
    </section>

    <section class="story-band" id="docs">
      <div class="story-wrap">
        <h2>{isZh ? "文档" : "Documentation"}</h2>
        <div class="story-links">
          {
            study.deployment?.channels.map((channel) => (
              <a href={channel.href} target="_blank" rel="noopener noreferrer">
                {channel.label}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="back-nav-footer">
      <div class="container">
        <BackNav href={workHref} label={page.caseBackLabel} prominent />
      </div>
    </section>
  </main>
  <Contact
    label={copy.contactLabel}
    hint={copy.contactHint}
    offers={copy.contactOffers}
    copyLabel={copy.copyEmail}
    copiedLabel={copy.copiedEmail}
  />
  <Footer
    brand={copy.brand}
    description={page.footerDesc}
    copyright={copy.copyright}
    social={page.social}
  />
</BaseLayout>
