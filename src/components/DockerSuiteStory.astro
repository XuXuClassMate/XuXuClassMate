---
import BackNav from "./BackNav.astro";
import Footer from "./Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCase, getCopy, pageHref, type Locale } from "../lib/i18n";
import { getMetrics, resolveMetric } from "../lib/metrics";

type Props = { locale: Locale };

const { locale } = Astro.props;
const copy = getCopy(locale);
const page = copy.work;
const study = getCase(locale, "docker-suite");
const metrics = await getMetrics();
const workHref = pageHref(locale, "work");

if (!study) {
  throw new Error("Missing docker-suite case");
}

const databases = ["Dameng", "Highgo", "Kingbase", "TiDB"];
---

<BaseLayout locale={locale} page="work" caseSlug="docker-suite" ogImagePath={study.cover} metaOverride={study.meta}>
  <main id="main-content" class="story story--infra apple-page">
    <section class="story-hero story-hero--infra">
      <div class="story-wrap">
        <BackNav href={workHref} label={page.caseBackLabel} />
        <p class="subtitle">INFRASTRUCTURE</p>
        <h1>{study.title}</h1>
        <p class="story-lead">{study.description}</p>
        <ul class="db-row">
          {databases.map((name) => <li>{name}</li>)}
        </ul>
      </div>
    </section>

    <section class="story-band story-band--proof">
      <div class="story-wrap">
        <h2>Usage Statistics</h2>
        <div class="story-metrics">
          {
            study.metrics.map((metric) => (
              <article>
                <span
                  {...(metric.metric
                    ? {
                        "data-metric": metric.metric,
                        "data-metric-fallback": metric.value,
                      }
                    : {})}
                >
                  {resolveMetric(metrics, metric.metric, metric.value)}
                </span>
                <p>{metric.label}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="story-band">
      <div class="story-wrap">
        <h2>Quick Start</h2>
        {study.deployment?.summary ? <p class="story-lead">{study.deployment.summary}</p> : null}
        <div class="terminal">
          <div class="terminal-bar">
            <span class="terminal-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>Terminal</span>
            <button
              type="button"
              class="terminal-copy"
              data-copy-target="docker-pulls"
              data-copy-label="Copy"
              data-copied-label="Copied"
            >
              "Copy"
            </button>
          </div>
          <pre class="terminal-body" id="docker-pulls"><code><span class="tok-cmt"># Pin a tag in CI. Ports and env follow that image's docs.</span>
<span class="tok-cmd">docker</span> <span class="tok-kw">pull</span> <span class="tok-img">xuxuclassmate/dameng</span>
<span class="tok-cmd">docker</span> <span class="tok-kw">pull</span> <span class="tok-img">xuxuclassmate/highgo</span>
<span class="tok-cmd">docker</span> <span class="tok-kw">pull</span> <span class="tok-img">xuxuclassmate/kingbase</span>
<span class="tok-cmd">docker</span> <span class="tok-kw">pull</span> <span class="tok-img">xuxuclassmate/tidb</span>

<span class="tok-cmd">docker</span> <span class="tok-kw">run</span> -d --name qa-dameng \
  -p 5236:5236 \
  -e DM_PASSWORD=ChangeMe \
  <span class="tok-img">xuxuclassmate/dameng</span></code></pre>
        </div>
        <ol class="story-steps">
          {study.deployment?.steps.map((step) => <li>{step}</li>)}
        </ol>
      </div>
    </section>

    <section class="story-band">
      <div class="story-wrap">
        <h2>Documentation</h2>
        <p class="story-lead">
          Pin tags in CI. Ports and environment variables follow each image's docs — no extra wrapper.
        </p>
        <div class="story-links">
          {
            study.deployment?.channels.map((channel) => (
              <a href={channel.href} target="_blank" rel="noopener noreferrer">
                {channel.label}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="back-nav-footer">
      <div class="container">
        <BackNav href={workHref} label={page.caseBackLabel} prominent />
      </div>
    </section>
  </main>
  <Footer
    brand={copy.brand}
    description={page.footerDesc}
    copyright={copy.copyright}
    social={page.social}
  />
</BaseLayout>
