---
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import PageHero from "./PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCopy, noteHref, type Locale } from "../lib/i18n";

type Props = { locale: Locale };

const { locale } = Astro.props;
const copy = getCopy(locale);
const page = copy.notes;
---

<BaseLayout locale={locale} page="notes">
  <main id="main-content">
    <PageHero
      subtitle={page.subtitle}
      title={page.title}
      description={page.description}
    />

    <section class="notes-index">
      <div class="container">
        <div class="notes-grid notes-grid--index">
          {
            page.items.map((item, index) => (
              <article
                class={`note-card note-card--rich reveal-on-scroll reveal-delay-${(index % 3) + 1}`}
              >
                <ul class="note-tags">
                  {item.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
                <h2>
                  <a href={noteHref(locale, item.slug)}>{item.title}</a>
                </h2>
                <p>{item.description}</p>
                {item.proof ? <p class="note-card-proof">{item.proof}</p> : null}
                <a class="read-more" href={noteHref(locale, item.slug)}>
                  {locale === "zh" ? "阅读全文" : "Read the note"}
                  <span aria-hidden="true">→</span>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Contact
    label={copy.contactLabel}
    hint={copy.contactHint}
    offers={copy.contactOffers}
    copyLabel={copy.copyEmail}
    copiedLabel={copy.copiedEmail}
  />
  <Footer
    brand={copy.brand}
    description={page.footerDesc}
    copyright={copy.copyright}
    social={page.social}
  />
</BaseLayout>
