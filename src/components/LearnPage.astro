---
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import PageHero from "./PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCopy, type Locale } from "../lib/i18n";

type Props = { locale: Locale };

const { locale } = Astro.props;
const copy = getCopy(locale);
const page = copy.learn;
const isZh = locale === "zh";
const storyLabels = isZh
  ? {
      background: "背景",
      problem: "问题",
      role: "职责",
      approach: "方案",
      verification: "验证",
      result: "结果与口径",
    }
  : {
      background: "Background",
      problem: "Problem",
      role: "Role",
      approach: "Approach",
      verification: "Verification",
      result: "Result and scope",
    };
---

<BaseLayout locale={locale} page="learn">
  <main id="main-content">
    <PageHero
      subtitle={page.subtitle}
      title={page.title}
      description={page.description}
    />

    <section class="timeline-section">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{isZh ? "工程经历" : "Engineering Journey"}</h2>
        <ol class="timeline">
          {
            page.timeline.map((item, index) => (
              <li
                class={`timeline-item reveal-on-scroll reveal-delay-${(index % 3) + 1}`}
              >
                <span class="timeline-index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div class="timeline-body">
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="experience-stories">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{isZh ? "工程难题" : "Selected Engineering Challenges"}</h2>
        <div class="stories-grid stories-grid--cases">
          {
            page.stories.map((item, index) => (
              <article
                class={`story-card reveal-on-scroll reveal-delay-${(index % 3) + 1}`}
              >
                <h3>{item.title}</h3>
                <dl class="story-case">
                  <div>
                    <dt>{storyLabels.background}</dt>
                    <dd>{item.background}</dd>
                  </div>
                  <div>
                    <dt>{storyLabels.problem}</dt>
                    <dd>{item.challenge}</dd>
                  </div>
                  <div>
                    <dt>{storyLabels.role}</dt>
                    <dd>{item.role}</dd>
                  </div>
                  <div>
                    <dt>{storyLabels.approach}</dt>
                    <dd>{item.approach}</dd>
                  </div>
                  <div>
                    <dt>{storyLabels.verification}</dt>
                    <dd>{item.verification}</dd>
                  </div>
                  <div>
                    <dt>{storyLabels.result}</dt>
                    <dd>{item.result}</dd>
                  </div>
                </dl>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="skills">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{isZh ? "技术决定" : "Technical Decisions"}</h2>
        <ul class="story-plain">
          {page.stories.map((item) => (
            <li>
              <strong>{item.title}.</strong> {item.decision}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="experience-stories">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{isZh ? "可核结果" : "Measurable Outcomes"}</h2>
        <ul class="story-plain">
          {page.stories.map((item) => (
            <li>
              <strong>{item.title}.</strong> {item.result}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="current-learning">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{isZh ? "当前重点" : "Current Focus"}</h2>
        <div class="focus-content reveal-on-scroll">
          <div class="focus-item">
            <h3>{page.focusHeading}</h3>
            <p>{page.focusIntro}</p>
            <ul>
              {page.focusItems.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="learn-funnel">
      <div class="container reveal-on-scroll">
        <div class="learn-funnel-panel">
          <h2>{locale === "zh" ? "继续往下看" : "Keep going"}</h2>
          <p>
            {
              locale === "zh"
                ? "从旗舰 AI 用例生成器开始验证可安装能力，或继续读工程笔记。"
                : "Start with the flagship AI Test Case Generator, or keep reading Engineering Notes."
            }
          </p>
          <div class="hero-actions">
            <a
              class="btn-primary"
              href={
                locale === "zh"
                  ? "/zh/work/testcase-generator"
                  : "/en/work/testcase-generator"
              }
            >
              {locale === "zh" ? "旗舰案例" : "Flagship case study"}
            </a>
            <a
              class="btn-ghost"
              href={
                locale === "zh"
                  ? "/zh/demo/ai-testcase-generator"
                  : "/en/demo/ai-testcase-generator"
              }
            >
              {locale === "zh" ? "试用 Demo" : "Try demo"}
            </a>
            <a class="btn-ghost" href={locale === "zh" ? "/zh/blog" : "/en/blog"}>
              {locale === "zh" ? "工程笔记" : "Engineering Notes"}
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Contact
    label={copy.contactLabel}
    hint={copy.contactHint}
    offers={copy.contactOffers}
    copyLabel={copy.copyEmail}
    copiedLabel={copy.copiedEmail}
  />
  <Footer
    brand={copy.brand}
    description={page.footerDesc}
    copyright={copy.copyright}
    social={page.social}
  />
</BaseLayout>
