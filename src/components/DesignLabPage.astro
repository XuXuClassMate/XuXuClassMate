---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale } from "../lib/i18n";

type Props = { locale: Locale };

const { locale } = Astro.props;
---

<BaseLayout
  locale={locale}
  page="about"
  noindex={true}
  metaOverride={{
    title: "Design Lab",
    description: "Glass material controls, not part of the public site.",
    keywords: "design lab",
  }}
>
  <main id="main-content" class="story apple-page design-lab-page">
    <section class="story-hero">
      <div class="story-wrap">
        <h1>Design Lab</h1>
        <p class="story-lead">
          Glass tint lives here, not in the public navigation.
        </p>
        <div class="glass-tint" data-glass-tint>
          <button
            type="button"
            class="glass-tint-toggle"
            id="glassTintToggle"
            aria-expanded="false"
            aria-controls="glassTintPanel"
            data-glass-tint-toggle
          >
            "Glass"
          </button>
          <div class="glass-tint-panel" id="glassTintPanel" data-glass-tint-panel>
            <div class="glass-tint-label">
              <span>Clear</span>
              <span>Tinted</span>
            </div>
            <input
              id="glassTintSlider"
              type="range"
              min="0"
              max="100"
              value="45"
              aria-label="Adjust glass tint"
              data-glass-tint-slider
            />
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
