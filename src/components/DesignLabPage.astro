---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale } from "../lib/i18n";

type Props = { locale: Locale };

const { locale } = Astro.props;
const isZh = locale === "zh";
---

<BaseLayout
  locale={locale}
  page="about"
  noindex={true}
  metaOverride={{
    title: isZh ? "设计实验室" : "Design Lab",
    description: isZh ? "玻璃材质调试，不面向普通访客。" : "Glass material controls, not part of the public site.",
    keywords: "design lab",
  }}
>
  <main id="main-content" class="story apple-page design-lab-page">
    <section class="story-hero">
      <div class="story-wrap">
        <h1>{isZh ? "设计实验室" : "Design Lab"}</h1>
        <p class="story-lead">
          {
            isZh
              ? "玻璃通透度只在这里调整，不出现在普通导航里。"
              : "Glass tint lives here, not in the public navigation."
          }
        </p>
        <div class="glass-tint" data-glass-tint>
          <button
            type="button"
            class="glass-tint-toggle"
            id="glassTintToggle"
            aria-expanded="false"
            aria-controls="glassTintPanel"
            data-glass-tint-toggle
          >
            {isZh ? "玻璃" : "Glass"}
          </button>
          <div class="glass-tint-panel" id="glassTintPanel" data-glass-tint-panel>
            <div class="glass-tint-label">
              <span>{isZh ? "通透" : "Clear"}</span>
              <span>{isZh ? "着色" : "Tinted"}</span>
            </div>
            <input
              id="glassTintSlider"
              type="range"
              min="0"
              max="100"
              value="45"
              aria-label={isZh ? "调整玻璃着色" : "Adjust glass tint"}
              data-glass-tint-slider
            />
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
