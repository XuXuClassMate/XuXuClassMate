---
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import PageHero from "./PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCopy, type Locale } from "../lib/i18n";

type Props = { locale: Locale };

const { locale } = Astro.props;
const copy = getCopy(locale);
const page = copy.openSource;
---

<BaseLayout locale={locale} page="open-source">
  <main id="main-content" class="org-page">
    <PageHero
      subtitle={page.subtitle}
      title={page.title}
      description={page.description}
      actions={[
        {
          href: page.orgCtaHref,
          label: page.orgCtaLabel,
          primary: true,
          external: true,
        },
      ]}
    />

    <section class="org-brand" aria-labelledby="org-brand-heading">
      <div class="container">
        <h2 class="section-title reveal-on-scroll" id="org-brand-heading">
          {page.brandTitle}
        </h2>
        <p class="org-brand-lead reveal-on-scroll">{page.brandLead}</p>
        <div class="org-brand-map reveal-on-scroll">
          <article class="org-brand-panel">
            <p class="org-brand-kicker">{page.brandPersonalLabel}</p>
            <h3 class="org-brand-name">{copy.brand}</h3>
            <ul class="org-brand-items">
              {
                page.brandPersonalItems.map((item) => (
                  <li>{item}</li>
                ))
              }
            </ul>
          </article>

          <div class="org-brand-connector" aria-hidden="true">
            <span class="org-brand-connector-line"></span>
            <span class="org-brand-connector-label">{page.brandConnector}</span>
            <span class="org-brand-connector-line"></span>
          </div>

          <article class="org-brand-panel org-brand-panel--org">
            <p class="org-brand-kicker">{page.brandOrgLabel}</p>
            <h3 class="org-brand-name">{page.orgName}</h3>
            <ul class="org-brand-items">
              {
                page.brandOrgItems.map((item) => (
                  <li>{item}</li>
                ))
              }
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="org-about">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{page.aboutTitle}</h2>
        <div class="org-about-grid">
          {
            page.about.map((paragraph, index) => (
              <p
                class={`org-about-copy reveal-on-scroll reveal-delay-${(index % 3) + 1}`}
              >
                {paragraph}
              </p>
            ))
          }
        </div>
      </div>
    </section>

    <section class="org-projects">
      <div class="container">
        <h2 class="section-title reveal-on-scroll">{page.categoriesTitle}</h2>
        {
          page.categories.map((category, categoryIndex) => (
            <div
              class={`org-category reveal-on-scroll reveal-delay-${(categoryIndex % 3) + 1}`}
              id={`oss-${category.id.toLowerCase().replace(/\s+/g, "-")}`}
            >
              <div class="org-category-head">
                <h3>{category.title}</h3>
                <p>{category.description}</p>
              </div>
              {category.projects.length > 0 ? (
                <div class="org-project-grid">
                  {category.projects.map((project) => (
                    <article class="org-project-card">
                      <div class="org-project-head">
                        <h4>{project.title}</h4>
                        {project.status ? (
                          <span class="org-project-status">{project.status}</span>
                        ) : null}
                      </div>
                      {project.org ? (
                        <p class="org-project-org">{project.org}</p>
                      ) : null}
                      <p>{project.description}</p>
                      {project.tags && project.tags.length > 0 ? (
                        <ul class="org-project-tags">
                          {project.tags.map((tag) => (
                            <li>{tag}</li>
                          ))}
                        </ul>
                      ) : null}
                      <div class="org-project-actions">
                        {project.href && project.href !== "#" ? (
                          <a
                            class="project-link"
                            href={project.href}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {project.linkLabel ?? "GitHub"}
                          </a>
                        ) : (
                          <span class="org-project-soon">
                            {project.linkLabel}
                          </span>
                        )}
                        {project.ctaHref ? (
                          <a
                            class="project-link"
                            href={project.ctaHref}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {project.ctaLabel}
                          </a>
                        ) : null}
                      </div>
                    </article>
                  ))}
                </div>
              ) : (
                <p class="org-category-empty">{page.emptyCategory}</p>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <section class="org-join">
      <div class="container">
        <div class="org-join-panel reveal-on-scroll">
          <h2>{page.joinTitle}</h2>
          <p>{page.joinIntro}</p>
          <ul>
            {page.joinItems.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <a
            class="btn-primary"
            href={page.orgCtaHref}
            target="_blank"
            rel="noopener noreferrer"
          >
            {page.orgCtaLabel}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Contact
    label={copy.contactLabel}
    hint={copy.contactHint}
    offers={copy.contactOffers}
    copyLabel={copy.copyEmail}
    copiedLabel={copy.copiedEmail}
  />
  <Footer
    brand={copy.brand}
    description={page.footerDesc}
    copyright={copy.copyright}
    social={page.social}
  />
</BaseLayout>
