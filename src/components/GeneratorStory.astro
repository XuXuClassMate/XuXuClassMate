---
import BackNav from "./BackNav.astro";
import Footer from "./Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCase, getCopy, pageHref, type Locale } from "../lib/i18n";
import { getMetrics, resolveMetric } from "../lib/metrics";

type Props = { locale: Locale };

const { locale } = Astro.props;
const isZh = locale === "zh";
const copy = getCopy(locale);
const page = copy.work;
const study = getCase(locale, "testcase-generator");
const metrics = await getMetrics();
const workHref = pageHref(locale, "work");

if (!study) {
  throw new Error("Missing testcase-generator case");
}

const productLine = isZh
  ? "可安装的 AI 工具，可信赖的质量。"
  : "AI tools you can install — quality you can trust.";

const shots = [
  {
    src: "/images/product-generator-input.jpg",
    title: isZh ? "上传需求" : "Upload a requirement",
    alt: isZh ? "交互 Demo 中已载入的需求" : "A requirement loaded in the interactive demo",
    body: isZh
      ? "PDF、Word、图片或视频进去之后，先抽出验收标准，再写用例。"
      : "PDF, Word, image, or video goes in. Acceptance criteria come out before any case is written.",
  },
  {
    src: "/images/product-generator-cases.jpg",
    title: isZh ? "AI 生成" : "AI generates cases",
    alt: isZh ? "生成的结构化测试用例" : "Structured test cases from the interactive demo",
    body: isZh
      ? "生成带步骤、预期结果和优先级的结构化用例。"
      : "Drafts structured cases with steps, expected results, and priority.",
  },
  {
    src: "/images/product-generator-review.jpg",
    title: isZh ? "人工审核" : "Human review",
    alt: isZh ? "QA、开发、产品角色审核" : "QA, developer, and product review roles",
    body: isZh
      ? "QA、开发和产品按覆盖、逻辑、可执行、清晰、安全打分。默认 90 分过线，最多五轮。"
      : "QA, Dev, and Product score the same cases on coverage, logic, executability, clarity, and security. The default bar is 90 out of 100, across at most five rounds.",
  },
  {
    src: "/images/product-generator-export.jpg",
    title: isZh ? "结构化导出" : "Structured export",
    alt: isZh ? "Excel、Markdown 和 XMind 导出" : "Excel, Markdown, and XMind export",
    body: isZh
      ? "审核后的结果导出为 Excel、Markdown 和 XMind。"
      : "Excel, Markdown, and XMind from the reviewed set.",
  },
];

const note = study.links.find((link) => /engineering note/i.test(link.label));

function paintCommand(command: string): string {
  return command
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .split("\n")
    .map((line) => {
      if (line.trimStart().startsWith("#")) return `<span class="tok-cmt">${line}</span>`;
      return line
        .replace(/\b(docker|npm|testcase-generator)\b/g, '<span class="tok-cmd">$1</span>')
        .replace(/\b(pull|run|install)\b/g, '<span class="tok-kw">$1</span>');
    })
    .join("\n");
}
---

<BaseLayout locale={locale} page="work" caseSlug="testcase-generator" ogImagePath={study.cover} metaOverride={study.meta}>
  <main id="main-content" class="story story--product apple-page">
    <section class="story-hero">
      <div class="story-wrap story-split">
        <div class="story-copy">
          <BackNav href={workHref} label={page.caseBackLabel} />
          <p class="subtitle">{isZh ? "旗舰" : "FLAGSHIP"}</p>
          <h1>{study.title}</h1>
          <p class="story-line">{productLine}</p>
          <div class="story-links">
            {
              study.tryItNow ? (
                <a class="btn-primary" href={study.tryItNow.primary.href}>
                  {study.tryItNow.primary.label}
                </a>
              ) : null
            }
            <a href="https://github.com/InnoNestX/testcase-generator" target="_blank" rel="noopener noreferrer">
              GitHub
            </a>
          </div>
        </div>
        <figure class="device showcase">
          <div class="device-bar" aria-hidden="true"><span></span><span></span><span></span></div>
          <img
            src="/images/product-generator-workspace.jpg"
            alt={shots[1].alt}
            width="1200"
            height="420"
          />
        </figure>
      </div>
    </section>

    <section class="story-band" id="workflow">
      <div class="story-wrap">
        <h2>{isZh ? "工作流" : "Workflow"}</h2>
        <ol class="story-flow">
          {
            study.pipeline?.stages.map((stage, index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>
                  {
                    (isZh
                      ? ["上传需求", "AI 生成", "人工审核", "结构化导出"]
                      : ["Requirements upload", "AI generation", "Human review", "Structured export"])[index] ?? stage
                  }
                </strong>
                {stage}
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="story-band story-film" id="features">
      <div class="film" data-film>
        <div class="film-pin">
          <h2>{isZh ? "产品功能" : "Product Features"}</h2>
          <div class="film-stage">
            {
              shots.map((shot) => (
                <article class="film-step">
                  <figure class="film-frame device">
                    <div class="device-bar" aria-hidden="true"><span></span><span></span><span></span></div>
                    <img src={shot.src} alt={shot.alt} width="1200" height="640" />
                  </figure>
                  <div class="film-caption">
                    <h3>{shot.title}</h3>
                    <p>{shot.body}</p>
                  </div>
                </article>
              ))
            }
          </div>
          <div class="film-meter" aria-hidden="true">
            <span></span>
          </div>
        </div>
      </div>
    </section>

    <section class="story-band" id="engineering">
      <div class="story-wrap">
        <h2>{isZh ? "工程架构" : "Engineering Architecture"}</h2>
        {
          study.architecture?.map((chain) => (
            <div class="story-arch">
              <h3>{chain.title}</h3>
              <ol>
                {chain.layers.map((layer) => (
                  <li>{layer}</li>
                ))}
              </ol>
            </div>
          ))
        }
        {
          study.contribution?.[0] ? <p class="story-note">{study.contribution[0]}</p> : null
        }
        {
          study.techStack?.length ? (
            <p class="story-note">{study.techStack.join(" · ")}</p>
          ) : null
        }
        {
          study.tradeoffs?.[0] ? <p class="story-note">{study.tradeoffs[0]}</p> : null
        }
      </div>
    </section>

    <section class="story-band story-band--proof" id="proof">
      <div class="story-wrap">
        <h2>{isZh ? "采用证明" : "Proof & Adoption"}</h2>
        <p class="story-lead">
          {
            isZh
              ? "Docker 拉取经 Docker Hub API Gateway 实时采集；npm 与 OpenClaw / ClawHub 同步刷新。"
              : "Docker pulls refresh live via the Docker Hub API Gateway; npm and OpenClaw / ClawHub stay in sync."
          }
        </p>
        <div class="story-metrics">
          {
            study.metrics.map((metric) => (
              <article>
                <span
                  {...(metric.metric
                    ? {
                        "data-metric": metric.metric,
                        "data-metric-fallback": metric.value,
                      }
                    : {})}
                >
                  {resolveMetric(metrics, metric.metric, metric.value)}
                </span>
                {
                  metric.href ? (
                    <a href={metric.href} target="_blank" rel="noopener noreferrer">
                      {metric.label}
                    </a>
                  ) : (
                    <p>{metric.label}</p>
                  )
                }
              </article>
            ))
          }
        </div>
        <p class="story-embed">
          <a
            href="https://docker-hub-pull-counter.vercel.app/api/repo/details?namespace=xuxuclassmate&repo=testcase-generator"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img
              src="https://docker-hub-pull-counter.vercel.app/api/docker-stats?username=xuxuclassmate&repo=testcase-generator"
              alt={isZh ? "testcase-generator Docker 拉取实时卡片" : "testcase-generator Docker pulls live card"}
              width="420"
              height="180"
            />
          </a>
        </p>
      </div>
    </section>

    <section class="story-band story-band--start" id="start">
      <div class="story-wrap">
        <h2>{isZh ? "开始使用" : "Get Started"}</h2>
        {study.tryItNow?.note ? <p class="story-tip">{study.tryItNow.note}</p> : null}
        {
          study.tryItNow?.command ? (
            <div class="terminal">
              <div class="terminal-bar">
                <span class="terminal-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span>Terminal</span>
                <button
                  type="button"
                  class="terminal-copy"
                  data-copy-target="generator-run"
                  data-copy-label={isZh ? "复制" : "Copy"}
                  data-copied-label={isZh ? "已复制" : "Copied"}
                >
                  {isZh ? "复制" : "Copy"}
                </button>
              </div>
              <pre class="terminal-body" id="generator-run" set:html={paintCommand(study.tryItNow.command)} />
            </div>
          ) : null
        }
        <div class="story-links">
          {
            study.tryItNow?.secondary
              ?.filter((link) => /docs|docker hub/i.test(link.label))
              .map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              ))
          }
          {
            note ? (
              <a href={note.href}>{note.label}</a>
            ) : null
          }
        </div>
      </div>
    </section>

    <section class="back-nav-footer">
      <div class="container">
        <BackNav href={workHref} label={page.caseBackLabel} prominent />
      </div>
    </section>
  </main>
  <Footer
    brand={copy.brand}
    description={page.footerDesc}
    copyright={copy.copyright}
    social={page.social}
  />
</BaseLayout>
