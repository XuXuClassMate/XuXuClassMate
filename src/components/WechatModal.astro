---
type Props = {
  alt: string;
  closeLabel: string;
};

const { alt, closeLabel } = Astro.props;
---

<div
  class="modal"
  id="wechatModal"
  role="dialog"
  aria-modal="true"
  aria-label={alt}
  hidden
>
  <div class="modal-content" tabindex="-1">
    <button class="close-button" id="closeModal" type="button" aria-label={closeLabel}>
      ×
    </button>
    <img
      src="/images/wechat.jpg"
      alt={alt}
      width="800"
      height="1080"
      loading="lazy"
      decoding="async"
    />
  </div>
</div>
