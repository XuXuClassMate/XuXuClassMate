---
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCase, getCopy, pageHref, type CaseSlug, type Locale } from "../lib/i18n";
import { getMetrics, resolveMetric } from "../lib/metrics";

type Props = {
  locale: Locale;
  slug: CaseSlug;
};

const { locale, slug } = Astro.props;
const copy = getCopy(locale);
const page = copy.work;
const study = getCase(locale, slug);
const metrics = await getMetrics();

if (!study) {
  throw new Error(`Unknown case study: ${slug}`);
}

const coverDark =
  study.coverDark ?? study.cover.replace(/\.jpg$/i, "-dark.jpg");
---

<BaseLayout
  locale={locale}
  page="work"
  caseSlug={slug}
  ogImagePath={study.cover}
  metaOverride={study.meta}
>
  <main id="main-content" class="case-page">
    <section class="hero hero--case">
      <div class="hero-atmosphere" aria-hidden="true"></div>
      <div class="container hero-content reveal">
        <a class="case-back" href={pageHref(locale, "work")}>
          ← {page.caseBackLabel}
        </a>
        <span class="subtitle">{study.subtitle}</span>
        <h1 class="hero-title">{study.title}</h1>
        <p class="hero-desc">{study.description}</p>
      </div>
    </section>

    <section class="case-cover">
      <div class="container case-cover-frame reveal-on-scroll">
        <img
          class="case-cover-image theme-cover theme-cover--light"
          src={study.cover}
          alt={study.coverAlt}
          width="960"
          height="540"
          loading="eager"
          decoding="async"
        />
        <img
          class="case-cover-image theme-cover theme-cover--dark"
          src={coverDark}
          alt=""
          width="960"
          height="540"
          loading="eager"
          decoding="async"
          aria-hidden="true"
        />
      </div>
    </section>

    <section class="case-body">
      <div class="container case-grid">
        <article class="case-block reveal-on-scroll">
          <h2>{page.caseProblemTitle}</h2>
          <p>{study.problem}</p>
        </article>
        <article class="case-block reveal-on-scroll">
          <h2>{page.caseSolutionTitle}</h2>
          <p>{study.solution}</p>
        </article>
        {
          study.tradeoffs && study.tradeoffs.length > 0 ? (
            <article class="case-block reveal-on-scroll">
              <h2>{page.caseTradeoffsTitle}</h2>
              <ul>
                {study.tradeoffs.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ) : null
        }
        <article class="case-block reveal-on-scroll">
          <h2>{page.caseOutcomesTitle}</h2>
          <ul>
            {study.outcomes.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        {
          study.artifacts && study.artifacts.length > 0 ? (
            <article class="case-block reveal-on-scroll">
              <h2>{page.caseArtifactsTitle}</h2>
              <div class="case-artifacts">
                {study.artifacts.map((artifact) => (
                  <div class="case-artifact">
                    <h3>{artifact.title}</h3>
                    <p>{artifact.description}</p>
                    {artifact.href ? (
                      <a
                        href={artifact.href}
                        class="project-link"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {artifact.linkLabel ?? artifact.href}
                      </a>
                    ) : null}
                  </div>
                ))}
              </div>
            </article>
          ) : null
        }
        <article class="case-block reveal-on-scroll">
          <h2>{page.caseMetricsTitle}</h2>
          <div class="case-metrics">
            {
              study.metrics.map((metric) => {
                const value = resolveMetric(metrics, metric.metric, metric.value);
                return (
                  <div class="case-metric">
                    <span
                      class="case-metric-value"
                      {...(metric.metric
                        ? {
                            "data-metric": metric.metric,
                            "data-metric-fallback": metric.value,
                          }
                        : {})}
                    >
                      {value}
                    </span>
                    <span class="case-metric-label">{metric.label}</span>
                  </div>
                );
              })
            }
          </div>
          {
            slug === "docker-suite" || slug === "docker-hub-api-gateway" ? (
              <p class="case-stats-embed">
                <a
                  href="https://hub.docker.com/u/xuxuclassmate"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <img
                    src="https://docker-hub-pull-counter.vercel.app/api/docker-stats?username=xuxuclassmate"
                    alt="xuxuclassmate Docker Hub live stats"
                    width="480"
                    height="120"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              </p>
            ) : null
          }
        </article>
        <article class="case-block reveal-on-scroll">
          <h2>{page.caseLinksTitle}</h2>
          <div class="project-links">
            {
              study.links.map((link) => (
                <a
                  href={link.href}
                  class="project-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {link.label}
                </a>
              ))
            }
          </div>
        </article>
      </div>
    </section>
  </main>

  <Contact
    label={copy.contactLabel}
    hint={copy.contactHint}
    offers={copy.contactOffers}
    copyLabel={copy.copyEmail}
    copiedLabel={copy.copiedEmail}
  />
  <Footer
    brand={copy.brand}
    description={page.footerDesc}
    copyright={copy.copyright}
    social={page.social}
  />
</BaseLayout>
