---
import BackNav from "./BackNav.astro";
import CaseHeading from "./CaseHeading.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getCase,
  getCopy,
  pageHref,
  type CaseSlug,
  type Locale,
} from "../lib/i18n";
import { getMetrics, resolveMetric } from "../lib/metrics";

type Props = {
  locale: Locale;
  slug: CaseSlug;
};

const { locale, slug } = Astro.props;
const copy = getCopy(locale);
const page = copy.work;
const study = getCase(locale, slug);
const metrics = await getMetrics();
const workHref = pageHref(locale, "work");

if (!study) {
  throw new Error(`Unknown case study: ${slug}`);
}

const coverDark =
  study.coverDark ?? study.cover.replace(/\.jpg$/i, "-dark.jpg");
const isZh = locale === "zh";
const narrative = slug === "testcase-generator" || slug === "docker-suite";
const infra = slug === "docker-suite";
const narrativeTitles: Record<string, string> = infra
  ? {
      problem: isZh ? "这个项目解决什么" : "What it is for",
      features: isZh ? "支持的数据库" : "Supported databases",
      role: isZh ? "我做了什么" : "What I did",
      deployment: isZh ? "拉取并运行" : "Pull and run",
      metrics: isZh ? "Docker Hub 数据" : "Docker Hub proof",
      github: "GitHub",
      liveDemo: isZh ? "安装入口" : "Install path",
      outcomes: isZh ? "交付了什么" : "What shipped",
      artifacts: isZh ? "可核验证据" : "Inspectable proof",
      links: isZh ? "链接" : "Links",
    }
  : {
      problem: isZh ? "问题" : "The Problem",
      solution: isZh ? "工作方式" : "How It Works",
      features: isZh ? "产品能力" : "Product Features",
      architecture: isZh ? "工程实现" : "Engineering",
      role: isZh ? "我做了什么" : "What I did",
      stack: isZh ? "技术" : "Stack",
      metrics: isZh ? "证据与入口" : "Proof & Access",
      deployment: isZh ? "如何运行" : "How to run",
      github: "GitHub",
      liveDemo: isZh ? "试用" : "Try it",
      tradeoffs: isZh ? "取舍" : "Tradeoffs",
      outcomes: isZh ? "交付了什么" : "What shipped",
      artifacts: isZh ? "可核验证据" : "Inspectable proof",
      links: isZh ? "链接" : "Links",
    };
const regionKeys = new Set(
  infra
    ? ["problem", "features", "deployment", "metrics"]
    : ["problem", "solution", "features", "architecture", "metrics"],
);

function titleFor(key: string, fallback: string, n: number) {
  if (!narrative) return `${String(n).padStart(2, "0")}. ${fallback}`;
  return narrativeTitles[key] ?? fallback;
}

function headingAs(key: string): "h2" | "h3" {
  if (!narrative || regionKeys.has(key)) return "h2";
  return "h3";
}

const githubHref =
  study.proof?.github ??
  study.links.find((link) => /github/i.test(link.label))?.href;

const liveDemoHref =
  study.proof?.demo ??
  study.tryItNow?.primary.href ??
  study.proof?.docker ??
  study.links.find((link) =>
    /live|demo|docker|clawhub|pulse|api/i.test(link.label),
  )?.href;
const liveDemoExternal = Boolean(liveDemoHref?.startsWith("http"));
const tryPrimaryExternal = Boolean(
  study.tryItNow?.primary.href.startsWith("http"),
);

const overviewText = study.overview ?? study.description;
const showOverview = overviewText !== study.description;
const roleItems =
  study.contribution && study.contribution.length > 0
    ? study.contribution
    : null;

const sectionNumbers = (() => {
  let n = 0;
  const next = () => {
    n += 1;
    return n;
  };
  return {
    overview: showOverview ? next() : 0,
    problem: next(),
    solution: next(),
    architecture: study.architecture?.length ? next() : 0,
    features: study.features?.length ? next() : 0,
    role: next(),
    stack: study.techStack?.length ? next() : 0,
    metrics: next(),
    deployment: next(),
    github: next(),
    liveDemo: next(),
    tradeoffs: study.tradeoffs?.length ? next() : 0,
    outcomes: study.outcomes?.length ? next() : 0,
    artifacts: study.artifacts?.length ? next() : 0,
    links: study.links?.length ? next() : 0,
  };
})();

const relatedNoteLinks = study.links.filter((link) =>
  /blog|note|article|笔记|文章|case study|案例/i.test(link.label),
);
---

<BaseLayout
  locale={locale}
  page="work"
  caseSlug={slug}
  ogImagePath={study.cover}
  metaOverride={study.meta}
>
  <main
    id="main-content"
    class:list={[
      "case-page",
      { "case-page--flagship": study.flagship, "case-page--narrative": narrative },
    ]}
  >
    <section class="hero hero--detail">
      <div class="hero-atmosphere" aria-hidden="true"></div>
      <div class="container">
        <div class="detail-topbar reveal">
          <BackNav href={workHref} label={page.caseBackLabel} />
        </div>
        <div class="hero-content hero-content--detail reveal">
          <span class="subtitle">{study.subtitle}</span>
          <h1 class="hero-title">{study.title}</h1>
          <p class="hero-desc">{study.description}</p>
          <div class="hero-actions">
            {
              study.tryItNow ? (
                <a class="btn-primary" href="#try-it-now">
                  {study.tryItNow.title}
                </a>
              ) : liveDemoHref ? (
                <a
                  class="btn-primary"
                  href={liveDemoHref}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {page.caseLiveDemoTitle}
                </a>
              ) : null
            }
            {
              githubHref ? (
                <a
                  class="btn-ghost"
                  href={githubHref}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  GitHub
                </a>
              ) : null
            }
          </div>
        </div>
      </div>
    </section>

    <section class="case-cover">
      <div class="container case-cover-frame reveal-on-scroll">
        <img
          class="case-cover-image theme-cover theme-cover--light"
          src={study.cover}
          alt={study.coverAlt}
          width="960"
          height="540"
          loading="eager"
          decoding="async"
        />
        <img
          class="case-cover-image theme-cover theme-cover--dark"
          src={coverDark}
          alt=""
          width="960"
          height="540"
          loading="eager"
          decoding="async"
          aria-hidden="true"
        />
      </div>
    </section>

    {
      study.pipeline ? (
        <section class="case-pipeline" aria-label="Product pipeline">
          <div class="container">
            <div class="pipeline-board reveal-on-scroll">
              <ul class="pipeline-inputs">
                {study.pipeline.inputs.map((input) => (
                  <li>{input}</li>
                ))}
              </ul>
              <ol class="pipeline-stages">
                {study.pipeline.stages.map((stage) => (
                  <li>
                    <span class="pipeline-arrow" aria-hidden="true">
                      ↓
                    </span>
                    <span class="pipeline-stage">{stage}</span>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </section>
      ) : null
    }

    <section class="case-body">
      <div class="container case-grid">
        {
          showOverview && !narrative ? (
            <article class="case-block reveal-on-scroll" id="overview">
              <CaseHeading
                as="h2"
                text={titleFor(
                  "overview",
                  page.caseOverviewTitle,
                  sectionNumbers.overview,
                )}
              />
              <p>{overviewText}</p>
            </article>
          ) : null
        }

        <article class="case-block reveal-on-scroll" id="problem">
          <CaseHeading
            as={headingAs("problem")}
            text={titleFor("problem", page.caseProblemTitle, sectionNumbers.problem)}
          />
          <p class="case-section-lead">{page.caseProblemLead}</p>
          <p>{study.problem}</p>
        </article>

        {
          !infra ? (
        <article class="case-block reveal-on-scroll" id="solution">
          <CaseHeading
            as={headingAs("solution")}
            text={titleFor(
              "solution",
              page.caseSolutionTitle,
              sectionNumbers.solution,
            )}
          />
          <p class="case-section-lead">{page.caseSolutionLead}</p>
          <p>{study.solution}</p>
        </article>
          ) : null
        }

        {
          study.architecture && study.architecture.length > 0 && !infra ? (
            <article class="case-block reveal-on-scroll" id="architecture">
              <CaseHeading
                as={headingAs("architecture")}
                text={titleFor(
                  "architecture",
                  page.caseArchitectureTitle,
                  sectionNumbers.architecture,
                )}
              />
              <p class="case-section-lead">{page.caseArchitectureLead}</p>
              {study.architecture.map((chain) => (
                <div class="arch-block">
                  <h3>{chain.title}</h3>
                  <ol class="arch-chain">
                    {chain.layers.map((layer) => (
                      <li>{layer}</li>
                    ))}
                  </ol>
                </div>
              ))}
            </article>
          ) : null
        }

        {
          study.features && study.features.length > 0 ? (
            <article class="case-block reveal-on-scroll" id="features">
              <CaseHeading
                as={headingAs("features")}
                text={titleFor(
                  "features",
                  page.caseFeaturesTitle,
                  sectionNumbers.features,
                )}
              />
              <p class="case-section-lead">{page.caseFeaturesLead}</p>
              <ul>
                {study.features.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ) : null
        }

        <article class="case-block reveal-on-scroll" id="role">
          <CaseHeading
            as={headingAs("role")}
            text={titleFor("role", page.caseRoleTitle, sectionNumbers.role)}
          />
          <p class="case-section-lead">{page.caseRoleLead}</p>
          {
            roleItems ? (
              <ul>
                {roleItems.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            ) : (
              <p>
                {isZh
                  ? "角色说明补充中。"
                  : "Role details are being expanded."}
              </p>
            )
          }
        </article>

        {
          study.techStack && study.techStack.length > 0 ? (
            <article class="case-block reveal-on-scroll" id="stack">
              <CaseHeading
                as={headingAs("stack")}
                text={titleFor("stack", page.caseStackTitle, sectionNumbers.stack)}
              />
              <p class="case-section-lead">{page.caseStackLead}</p>
              <ul class="stack-list stack-list--inline">
                {study.techStack.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ) : null
        }

        <article class="case-block reveal-on-scroll" id="metrics">
          <CaseHeading
            as={headingAs("metrics")}
            text={titleFor("metrics", page.caseMetricsTitle, sectionNumbers.metrics)}
          />
          <p class="case-section-lead">
            {
              slug === "testcase-generator"
                ? isZh
                  ? "Docker 拉取经 Docker Hub API Gateway 实时采集；npm 与 OpenClaw / ClawHub 同步刷新。"
                  : "Docker pulls refresh live via the Docker Hub API Gateway; npm and OpenClaw / ClawHub stay in sync."
                : page.caseMetricsLead
            }
          </p>
          <div class="case-metrics">
            {
              study.metrics.map((metric) => {
                const value = resolveMetric(
                  metrics,
                  metric.metric,
                  metric.value,
                );
                return (
                  <div class="case-metric">
                    <span
                      class="case-metric-value"
                      {...(metric.metric
                        ? {
                            "data-metric": metric.metric,
                            "data-metric-fallback": metric.value,
                          }
                        : {})}
                    >
                      {value}
                    </span>
                    {metric.href ? (
                      <a
                        class="case-metric-label case-metric-label--link"
                        href={metric.href}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {metric.label}
                      </a>
                    ) : (
                      <span class="case-metric-label">{metric.label}</span>
                    )}
                  </div>
                );
              })
            }
          </div>
          {
            slug === "testcase-generator" ? (
              <p class="case-stats-embed">
                <a
                  href="https://docker-hub-pull-counter.vercel.app/api/repo/details?namespace=xuxuclassmate&repo=testcase-generator"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <img
                    src="https://docker-hub-pull-counter.vercel.app/api/docker-stats?username=xuxuclassmate&repo=testcase-generator"
                    alt={
                      isZh
                        ? "testcase-generator Docker 拉取实时卡片"
                        : "testcase-generator Docker pulls live card"
                    }
                    width="420"
                    height="180"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              </p>
            ) : slug === "docker-suite" || slug === "docker-hub-api-gateway" ? (
              <p class="case-stats-embed">
                <a
                  href="https://docker-hub-pull-counter.vercel.app/api/user/stats?username=xuxuclassmate"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <img
                    src="https://docker-hub-pull-counter.vercel.app/api/docker-stats?username=xuxuclassmate"
                    alt="xuxuclassmate Docker Hub live stats"
                    width="480"
                    height="120"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              </p>
            ) : null
          }
        </article>

        <article class="case-block reveal-on-scroll" id="deployment">
          <CaseHeading
            as={headingAs("deployment")}
            text={titleFor(
              "deployment",
              page.caseDeploymentTitle,
              sectionNumbers.deployment,
            )}
          />
          <p class="case-section-lead">{page.caseDeploymentLead}</p>
          {
            study.deployment ? (
              <>
                <p>{study.deployment.summary}</p>
                <ol class="deployment-steps">
                  {study.deployment.steps.map((step) => (
                    <li>{step}</li>
                  ))}
                </ol>
                <div class="project-links">
                  {study.deployment.channels.map((channel) => (
                    <a
                      href={channel.href}
                      class="project-link"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {channel.label}
                    </a>
                  ))}
                </div>
              </>
            ) : (
              <p>
                {isZh
                  ? "部署与运行说明见下方 GitHub / Live Demo。"
                  : "See GitHub / Live Demo below for how to run this project."}
              </p>
            )
          }
        </article>

        <article class="case-block reveal-on-scroll" id="github">
          <CaseHeading
            as={headingAs("github")}
            text={titleFor("github", page.caseGithubTitle, sectionNumbers.github)}
          />
          {
            githubHref ? (
              <div class="project-links">
                <a
                  href={githubHref}
                  class="project-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {isZh ? "打开 GitHub 仓库" : "Open GitHub repository"}
                </a>
              </div>
            ) : (
              <p>
                {study.status === "upcoming"
                  ? isZh
                    ? "源码仓库即将公开。"
                    : "Source repository coming soon."
                  : isZh
                    ? "暂无公开 GitHub 仓库。"
                    : "No public GitHub repository yet."}
              </p>
            )
          }
        </article>

        <article class="case-block reveal-on-scroll" id="live-demo">
          <CaseHeading
            as={headingAs("liveDemo")}
            text={titleFor(
              "liveDemo",
              page.caseLiveDemoTitle,
              sectionNumbers.liveDemo,
            )}
          />
          {
            liveDemoHref ? (
              <div class="project-links">
                <a
                  href={liveDemoHref}
                  class="project-link"
                  target={liveDemoExternal ? "_blank" : undefined}
                  rel={liveDemoExternal ? "noopener noreferrer" : undefined}
                >
                  {isZh ? "打开在线体验 / 安装入口" : "Open live demo / install path"}
                </a>
                {study.tryItNow ? (
                  <a class="project-link project-link--secondary" href="#try-it-now">
                    {study.tryItNow.title}
                  </a>
                ) : null}
              </div>
            ) : (
              <p>
                {isZh
                  ? "在线体验入口即将补充。"
                  : "Live demo link coming soon."}
              </p>
            )
          }
        </article>

        {
          study.tradeoffs && study.tradeoffs.length > 0 && !infra ? (
            <article class="case-block reveal-on-scroll" id="tradeoffs">
              <CaseHeading
                as={headingAs("tradeoffs")}
                text={titleFor(
                  "tradeoffs",
                  page.caseTradeoffsTitle,
                  sectionNumbers.tradeoffs,
                )}
              />
              <ul>
                {study.tradeoffs.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ) : null
        }

        {
          study.outcomes && study.outcomes.length > 0 ? (
            <article class="case-block reveal-on-scroll" id="outcomes">
              <CaseHeading
                as={headingAs("outcomes")}
                text={titleFor(
                  "outcomes",
                  page.caseOutcomesTitle,
                  sectionNumbers.outcomes,
                )}
              />
              <ul>
                {study.outcomes.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ) : null
        }

        {
          study.artifacts && study.artifacts.length > 0 ? (
            <article class="case-block reveal-on-scroll" id="artifacts">
              <CaseHeading
                as={headingAs("artifacts")}
                text={titleFor(
                  "artifacts",
                  page.caseArtifactsTitle,
                  sectionNumbers.artifacts,
                )}
              />
              <div class="case-artifacts">
                {study.artifacts.map((item) => (
                  <article class="case-artifact">
                    <h3>{item.title}</h3>
                    <p>{item.description}</p>
                    {item.href ? (
                      <a
                        class="project-link"
                        href={item.href}
                        target={item.href.startsWith("http") ? "_blank" : undefined}
                        rel={
                          item.href.startsWith("http")
                            ? "noopener noreferrer"
                            : undefined
                        }
                      >
                        {item.linkLabel ?? (isZh ? "打开" : "Open")}
                      </a>
                    ) : null}
                  </article>
                ))}
              </div>
            </article>
          ) : null
        }

        {
          study.links && study.links.length > 0 ? (
            <article class="case-block reveal-on-scroll" id="links">
              <CaseHeading
                as={headingAs("links")}
                text={titleFor("links", page.caseLinksTitle, sectionNumbers.links)}
              />
              {relatedNoteLinks.length > 0 ? (
                <p class="case-section-lead">
                  {isZh
                    ? "安装入口、证据与延伸阅读。"
                    : "Install paths, proof, and deeper reading."}
                </p>
              ) : null}
              <div class="project-links">
                {study.links.map((link) => (
                  <a
                    href={link.href}
                    class="project-link"
                    target={link.href.startsWith("http") ? "_blank" : undefined}
                    rel={
                      link.href.startsWith("http")
                        ? "noopener noreferrer"
                        : undefined
                    }
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </article>
          ) : null
        }

        {
          study.tryItNow ? (
            <article class="case-block case-try reveal-on-scroll" id="try-it-now">
              <h2>{study.tryItNow.title}</h2>
              <p>{study.tryItNow.description}</p>
              {study.tryItNow.note ? (
                <p class="case-try-note">{study.tryItNow.note}</p>
              ) : null}
              {study.tryItNow.command ? (
                <pre class="case-try-command"><code>{study.tryItNow.command}</code></pre>
              ) : null}
              <div class="hero-actions">
                <a
                  class="btn-primary"
                  href={study.tryItNow.primary.href}
                  target={tryPrimaryExternal ? "_blank" : undefined}
                  rel={tryPrimaryExternal ? "noopener noreferrer" : undefined}
                >
                  {study.tryItNow.primary.label}
                </a>
                {study.tryItNow.secondary?.map((link) => (
                  <a
                    class="btn-ghost"
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </article>
          ) : null
        }
      </div>
    </section>

    <section class="back-nav-footer">
      <div class="container">
        <div class="back-nav-footer-panel">
          <p class="back-nav-footer-hint">
            {isZh ? "继续浏览其他项目" : "Browse more projects"}
          </p>
          <BackNav href={workHref} label={page.caseBackLabel} prominent />
        </div>
      </div>
    </section>
  </main>

  <Contact
    label={copy.contactLabel}
    hint={copy.contactHint}
    offers={copy.contactOffers}
    copyLabel={copy.copyEmail}
    copiedLabel={copy.copiedEmail}
  />
  <Footer
    brand={copy.brand}
    description={page.footerDesc}
    copyright={copy.copyright}
    social={page.social}
  />
</BaseLayout>
