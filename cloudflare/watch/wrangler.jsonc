{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xuxu-watch",
  "account_id": "d707d6027ca320d83325b0e23f4c4521",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },
  "routes": [
    {
      "pattern": "watch.xuxuclassmate.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ZONE_ID": "cc053b2af901bf44c7876a19f2bcc296",
    "ALLOWED_EMAIL": "xuxuclassmate@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "LOGS",
      "database_name": "xuxu-watch-http",
      "database_id": "e7bd3750-d916-4a5c-8f56-169cf2d39cea"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
