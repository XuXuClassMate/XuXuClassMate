{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xuxu-nas-login-branding",
  "account_id": "d707d6027ca320d83325b0e23f4c4521",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "routes": [
    {
      "pattern": "nas.xuxuclassmate.com/home",
      "zone_name": "xuxuclassmate.com"
    },
    {
      "pattern": "nas.xuxuclassmate.com/home/",
      "zone_name": "xuxuclassmate.com"
    },
    {
      "pattern": "nas.xuxuclassmate.com/home/login*",
      "zone_name": "xuxuclassmate.com"
    }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "LOGS",
      "database_name": "xuxu-watch-http",
      "database_id": "e7bd3750-d916-4a5c-8f56-169cf2d39cea"
    }
  ]
}
